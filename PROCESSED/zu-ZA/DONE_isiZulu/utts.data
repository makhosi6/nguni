( lwazi_0802 "Kwaba nokuvumelana ukuthi abazali kumele babambe iqhaza kanye nabaholi bomphakathi emfundweni." )
( lwazi_0803 "Funda lesi siqeshana esilandelayo ukhiphe izisho ezikhona bese unika nencazelo yazo." )
( lwazi_0804 "UThula wayekhuluma okokuqala kuyilokhu egcine imoto iseseMbali." )
( lwazi_0805 "Okuqaphelekayo ukuthi imisebenzi yabantu abansundu yancipha ngalesisikhathi." )
( lwazi_0806 "Sisamangele sabona kuvela onogada ngaphakathi ebhange bephethe amabhokisana emali." )
( lwazi_0807 "Wathi angaqeda ukukhuluma nabo udokotela wabanika amaphepha anemininingwane mayelana nalesi sifo." )
( lwazi_0808 "Singasiguqula kanjani isimo? Siyadinga ukwenza isimo sibe ngcono." )
( lwazi_0809 "Kungaleso sizathu ke futhi kufanele futhi ugqoke amagilavu uma usiza umuntu olimele." )
( lwazi_0810 "Akaze akubona okuyenza ibe imali mbumbulu waze wayihlola ngomshini wakhe wangabona lutho." )
( lwazi_0811 "Kwakungelula kuyena ukuthi ayeke uZongile okwase kunesikhathi emconsela amathe." )
( lwazi_0812 "Umbhali nomfundi wendaba baphila emhlabeni wangempela kanti umlandi uphila emhlabeni wendaba." )
( lwazi_0813 "Kusukela kungena uMbopha kuze kufike lapho uPhampatha ema phezu kwesidumbu sikaShaka?" )
( lwazi_0814 "Ngakho ke qaphela uhlale uvule amehlo ngaso sonke isikhathi uqikelele ugweme inhlekelele." )
( lwazi_0815 "Ukuchasisa izindawo ezidinga ukuthi kubhekwe inqubomgomo." )
( lwazi_0816 "Zazibaphoqelela abanikazi ukuthi bagcine ngakho ukuzilengisa ezintanyeni." )
( lwazi_0817 "Nginethemba elikhulu lokuthi uzohola lo mnyango ngendlela ezokwamukelwa yiziguli nemindeni yazo." )
( lwazi_0818 "Aveze ukugunyazeka kwakhe lapho ecelwa yilowo ohlala lapho noma umnikazi wendawo." )
( lwazi_0819 "Lesi simo singachaza ukubuyekeza umbono esikhathini esizayo nolwazi olungcono lapho kuhlelwa." )
( lwazi_0820 "Ukuqubuka kuvela izinsuku ezintathu kuya kwezinhlanu ngemva kokushisa." )
( lwazi_0821 "Ngiyokunikeza ifomu lokufaka isicelo uma ufuna ukufaka isicelo somyalelo walolu hlobo." )
( lwazi_0822 "Ingani naso sase sithole umngani esizohlala naye, kule mpilo yaso eyisiphithiphithi kuleli khaya." )
( lwazi_0823 "Lemihlinzeko yiyona okufanele iphonselwe inselelo ngesinyathelo sezinkantolo." )
( lwazi_0824 "Kwakuzokwenziwa amalungiselelo okuba uNzuza asale esebekwa ukuba abe nguMvangeli kulelo bandla." )
( lwazi_0825 "Yemboza ukudla ukuze kungathintwa yizimpukane nezilwane." )
( lwazi_0826 "Inani lalezi zimvume kulowo mkhakha ngeke leqa inani lomkhawulo othize obekwe kwinothisi." )
( lwazi_0827 "UZongile wayemi eduze kweketela lamanzi ayesebila ephuma nomphusho." )
( lwazi_0828 "Lokhu-ke kuzobe kuphathelene nokuxhumana ngomlomo nangokubhaliwe." )
( lwazi_0829 "Kubalukile ukuwuqonda umehluko phakathi kwale misebenzi ngoba imithetho esebenza kuyo ihlukile." )
( lwazi_0830 "Ngikhuluphele kakhulu kanti udokotela ungeluleke ngokuthi, kuzomele nginciphise umzimba." )
( lwazi_0831 "Incwadi efakazela okhulelwe isho nesikhathi asithethe aze abelethe imele ukuthi nayo ithunyelwe." )
( lwazi_0832 "Uthukulula isikhwama ekugcineni athi ukuhogela ugwayi wakhe." )
( lwazi_0833 "Iphoyisa lilokhu lilinde emnyango ukuthi isigebengu sizoqeda siphume kanti, alibuzanga elangeni." )
( lwazi_0834 "Ukubhudukeza omunye umqashwa noma ukuthukuthelisa umuntu emsebenzini." )
( lwazi_0835 "Ingabe kufanele ukuthi unike umnikazi wendawo noma umuntu ohlala kuleyo ndawo iwaranti?" )
( lwazi_0836 "Hlamba izandla zakho ngamanzi nensipho ngaphambi kokusebenzisa ithoyilethi." )
( lwazi_0837 "Abuyisele lokho akususile ngemva nje kokuqeda kwakhe ukukusebenzisa lokho athe wakususa." )
( lwazi_0838 "Eyi, kwangcono ngaze ngafika kwalo mfazi othatha ingane yami azoyifuyela lapha." )
( lwazi_0839 "Abantu abadala bavama ukukuthola kunzima ukuhamba amabanga amade nokuphakamisa izinto ezincane." )
( lwazi_0840 "Ukuzinikela kwenu okungakhathali futhi okukhombisa ubuqhawe, kwenze ngakwazi ukuba la namhlanje." )
( lwazi_0841 "Siyanibonga ngezindaba eziningi ezimnandi enisixoxele zona." )
( lwazi_0842 "Bazokuthumela lonke ulwazi oludingwa ngumuntu othumela impahla ngaphandle ukuze ubhalise." )
( lwazi_0843 "Lapha ngezansi kunemibuzo okufanele azibuze yona zonke izinsuku, umuntu ohlala epulazini." )
( lwazi_0844 "Yize kunjalo, sizama ngakho konke okusemandleni ukufinyelela kulabo abadinga usizo ngempela." )
( lwazi_0845 "Mthumele lesiya lapho umi khona wedwa emshadweni wethu noMveli." )
( lwazi_0846 "Ngangihlale ngizwa ngendaba ukuthi uma ufuna ukuvala umfula kumele uwuvale esiphethwini sawo." )
( lwazi_0847 "Wethenjiswa umhlomulo ongakusiza uma ungaqhubeka nokusebenza." )
( lwazi_0848 "UZongile wanhlanhlatha emaqeleni waye waphumela emgwaqeni omkhulu." )
( lwazi_0849 "Ngakho-ke siyacela kubo bonke ababambe iqhaza ukuthi bazibophezele ekusebenzeni kahle kohlelo." )
( lwazi_0850 "Isiqondiso kumbe umyalo okhishwe ngokwalo Mthetho." )
( lwazi_0851 "Kunemibono ethile ongasiza ngayo abantwana bakho ukuze bathathe izinqumo ezifanele ngempilo yabo." )
( lwazi_0852 "Bagcobe umzimba wonke kusuka emqaleni kuya ozwaneni." )
( lwazi_0853 "Uhambo lwami ngisuka lapho kwaNongoma ngiza ngapha eGoli lwaba luhle futhi lwaba mnandi kakhulu." )
( lwazi_0854 "Le mibhalo-ke ike yathunyelwa nakubantu abangongoti kulezi zilimi, ukuthi nabo bayicubungule." )
( lwazi_0855 "Kuyangixaka nje nokuthi usetshelwe ngubani ukuthi mina ngihlala lapha nani uma ngingekho ekhaya." )
( lwazi_0856 "Ezinye iZinhlangano nazo ezifisa ukuba yizinhlangano ezibhalisiwe, kumele zigcwalise isigaba sesithathu." )
( lwazi_0857 "Sicabanga ukuthi siqonda isimo uma sibona kuphela ingxenye yesimo sisizwe kancane kuphela." )
( lwazi_0858 "Umele ukuthi ube nencwadi yokugunyaza ukuthi imoto yakhiwe kuleli noma yakhiwe kwelinye izwe." )
( lwazi_0859 "Ukubhema, ukudla noma ukuphuza ngeze kwenziwa phambi komuntu osizwayo kulo lonke iGatsha." )
( lwazi_0860 "Iqoqo ngalinye linikezwe izithombe ukuba libuke bese bevumelana ngalokhu abakubonayo." )
( lwazi_0861 "Nanoma iyiphi ingane ebekwe ejele, kufanele iphathwe ngobuntu noma ngenhlonipho nesithunzi." )
( lwazi_0862 "Ngokuhamba kwesikhathi ke nokho kungade kulungiswa izinkomba zize zibonise imiphumela kangcono." )
( lwazi_0863 "Ukuphuza kakhulu isikhathi eside, kungawulimaza umzimba wakho ungaphinde ubuyele esimeni sawo." )
( lwazi_0864 "Yinqobo nje esithwale waze wayosibeka lapho esiya khona siphilile futhi siphephile." )
( lwazi_0865 "Uthobele zonke izimpawu zomgwaqo kanye nezimpawu zezimoto." )
( lwazi_0866 "Mina bengithi uzothi mhlawumbe akulona iqiniso lokhu okubhalwe laphaya kumazisi wakho." )
( lwazi_0867 "Ukunqaba ukuhlinzeka ngokufanele abadala ngezinkonzo zempilo." )
( lwazi_0868 "Uma ukungabhemi usukuthatha ngokuthi yiyona ndlela efanele impilo okumele iqhubeke ngayo." )
( lwazi_0869 "UNzuza wabambana kwathula umoya nesithunywa seNkosi esethembekile." )
( lwazi_0870 "Sekuboshwe abantu abaningi kanti futhi baningi abasozoboshwa." )
( lwazi_0871 "Into engcono umuntu angayenza wukuthi angaqali kwakuqala ukubhema noma akuyeke uma ekwenza." )
( lwazi_0872 "Ingagcina leyo ngane endaweni ephephile yesikhashana ize itholelwe enye indawo yokuhlala." )
( lwazi_0873 "Fundisisa ifomu uqinisekise ukuthi uphetha zonke izimfanelo zesimiso zesicelo." )
( lwazi_0874 "Iziqhano ezinamagama kufanele zigqokwe ngaso sonke isikhathi." )
( lwazi_0875 "Kudinga ukuthi umuntu azame ukusiza labo abadingayo nokugwema ukuzwisa abanye ubuhlungu." )
( lwazi_0876 "Lesi sigaba kufanele sigcwaliswe kuphela uma isicelo senziwe egameni lomunye umuntu." )
( lwazi_0877 "OSihlalo beNdlu bangabuye badingeke ukuba bangamele ukuhlala kweNdlu yesiShayamthetho Kazwelonke." )
( lwazi_0878 "Ngathenga utshwala ngahlala phansi ngaphuza nginganake lutho." )
( lwazi_0879 "Loku kusemqoka kakhulu eZingeni leMfundo eYisisekelo, lapho abafundi befunda ukufunda nokubhala." )
( lwazi_0880 "Ngaboleka ibhayisikili kumkhulu njengoba ehole izolo." )
( lwazi_0881 "Bamtshela ukuthi imali bayithola kuphela uma benikezwe ngabanikazi bezimoto." )
( lwazi_0882 "UNozi uhlala nendodakazi yakhe uLwazi endlini ayishiyelwa abazali bakhe asebashona." )
( lwazi_0883 "Ngixolisa angizenzisi kumama wesizwe ngobubi engabenza esikhathini esedlule kuyena." )
( lwazi_0884 "Lokho-ke, kungabeka impilo yakho engcupheni enkulu." )
( lwazi_0885 "Wathi angasho njalo lwathi gozololo uvalo kuMveli ngoba wayesecabanga ukuthi waliwe." )
( lwazi_0886 "Noma ubani osebenza kumbe onelungu lomndeni wakhe noma umngane osebenza ezimayini." )
( lwazi_0887 "Okumthokozisa kakhulu ukuthi useyabona ukuthi izifiso zakhe sezizofezeka." )
( lwazi_0888 "Uma umbhali ebhala incwadi usuke eqonde ukuthi indaba yakhe ifundwe yonke." )
( lwazi_0889 "Lamkhulula inhliziyo lelo ngoba wathola nesihlwashana." )
( lwazi_0890 "Lokhu kusho ukuthi ohulumeni kufanele banikeze nanoma yiluphi usizo enganeni ekhubazekile." )
( lwazi_0891 "Sebenzisana nomeluleki ukubumba umqulu oyisibuko esiyiso sobudlelwane obuhlongozwayo." )
( lwazi_0892 "Adumise injini ephehla ugesi ukuze akhanyise." )
( lwazi_0893 "Wayethi angaqeda esikoleni aphindele futhi esitolo ukuze abe noMfaniseni uma sekuvalwa." )
( lwazi_0894 "Uzitshele ukuthi izinto zizoba ngcono kusasa." )
( lwazi_0895 "Wonke umuntu wesifazane okhulelwe angangcina enazo izinkinga uma ekhulelwe noma uma esebeletha." )
( lwazi_0896 "Kodwa umzabalazo ababhekene nawo, bayophumelela kuphela uma abantu babo bezakhela ikusasa labo." )
( lwazi_0897 "Bekuyinhloso yokudala ubuhlobo okwenze ukuthi uShaka athumele izithunywa zakhe." )
( lwazi_0898 "Akuhlale njalo kuyindlela okungeyona kodwa kakhulu umfutho ongakhipha imiphumela eyakhayo." )
( lwazi_0899 "Siphinda sinikeze izibonelo zeziqephu ezingasetshenziswa ukuhlanganisa ukufundwa kolimi." )
( lwazi_0900 "Inkantolo iyonquma ukuthi, kufanele yini yemukele isicelo somuntu ofuna ukwedlulisa isikhalo." )
( lwazi_0901 "Wayenabo abanye abantwana nabondliwa nguye ababhalwe ngezansi." )
( lwazi_0902 "Uthe yena usebenzisa ijazi lomkhwenyana." )
( lwazi_0903 "Amaqiniso odaba yilawo ethulwa yithimba ngenhloso yokuveza ubufakazi ukuze linqobe icala." )
( lwazi_0904 "Ukuxoxela afunda nabo ekilasini ngezindaba azifundile." )
( lwazi_0905 "Ukwebiwa kogesi kuyingozi ekuhlinzekelweni kwesizukulwane esizayo ngogesi." )
( lwazi_0906 "Yikho-ke lokhu okwenza umuntu abuyele ekubhemeni usikilidi, ukuhlala ukhamise ungenzi lutho." )
( lwazi_0907 "Linda kuhlangane okungenani amahora amabili ngaphambi kokuphuza amanzi." )
( lwazi_0908 "Isikhulu esiphethe singahlola noma siphinde sihlole noma yimuphi umsebenzi emnyangweni waso." )
( lwazi_0909 "Nazo zonke izindaba lapho kwenziwa khona isicelo sesinqumo esichazwe esigabeni samashumi amane nesithupha." )
( lwazi_0910 "Izifo umuntu okhulelwe akade enazo ngaphambi kokuba akhulelwe kakhulukazi isifo senhliziyo." )
( lwazi_0911 "UNkonka wathi lapho evulela izivakashi sezigoduka wazithela kwezakadalawane." )
( lwazi_0912 "Kukhona abazali abaletha abantwana emhlabeni ngenhloso bese kuba khona labo ababaletha ngephutha." )
( lwazi_0913 "Ingani kuyashiwo ukuthi noma kufiwe kuyahlekwa ngoba insini ingumuthi omkhulu emoyeni womuntu?" )
( lwazi_0914 "Umthetho obusa kuzo zonke izimo usho umthetho osetshenziswa ngazo zonke izikhathi." )
( lwazi_0915 "Ngenisa njalo isitifiketi sokugula uma ufaka isicelo." )
( lwazi_0916 "Kuyaphinda futhi kuba nomsinjwana ovumelana nale nkulumo." )
( lwazi_0917 "Zingabamukela ubufakazi obutholwe ngokusesha okungekho emthethweni izinkantolo?" )
( lwazi_0918 "Ngiluhambile lolo hambo olude, oluphikelele enkululekweni." )
( govza_0001 "Asikukhiphi ejele, asingeni phakathi emihambisweni yezinkantolo zamanye amazwe, asinikani izeluleko ngezomthetho, asigxamalazeli noma siqale ukuqubeka kwemisebenzi yenkantolo asiceli iziphathimandla zendawo ukuba baphathe abantu baseMzansi ngedlela yokukhetha asiphenyi amacala obugebengu noma okufa emazweni, asikuphenyeli ubugebengu kwelinye izwe, asibhadaleli ukushiswa kwesidumbu, ukunqwaba noma ukuthwala isidumbu usibuyise ekhaya e South Africa, asimthathi umntwana obethunjiwe esiphoceleli umthetho wase South Africa wokuthi umntwana unikwe bani, enkatolo noma siphocelele inkantolo yelinye izwe ukuthi ikhiphe isigwebo ngokuthi umntwana unikezwa bani asikukhokheli ehotela, kubameli kubodokodela noma ezinye izindleko, asikukhokheli imali yokuhamba asiwenzi umsebenzi wabezokuthutha nabezezindiza noma amabhange, asikutholeli indawo yokuhlala,nomsebenzi noma sikutholele iphomedi yokusebenza, asikugcineli impahla noma sikufunele okulahlekile asemukeli izincwadi zakho zeposi, asikunikezi izinzuzo zakho zempesheni nezabelo ezithize, asibalekeleli abantu abayizakhamuzi zamazwe amabili kulelozwe lesibili." )
( govza_0002 "Kutholakala inzalo noma ukunqwabelelana kwemali yenzalo noma yempahla nesabelo senzalo kumasheya ama-Trust empahla." )
( govza_0003 "Uma kutholakala noma kunqwabelelana isabelo senzalo yamasheya empahla noma imali etshalwe kumazwe angaphandle." )
( govza_0004 "Uma kutholakala noma kunqwabelelane inzalo yamashaye angaphakathi kwezwe kutholakala inani lilonke lerente ekhokhwe ngabaqashi noma eqoqwe ngama-agent asebenzela omunye umuntu" )
( govza_0005 "maqondana nempahla echaziwe kunemali ekhokhelwe ilungelo lokusebenzisa impahla, kunengeniso eliyisabelo esivela kulungelo lobunikazi bezinto ezithile ezenziwa kudala ezifana nokubhala amabhuku nokunye." )
( govza_0006 "Noma kunezimali ezikhokhelwa ukusetshenziswa kwelungelo lobuqambi bezinto ezintsha,idizayini, ilungelo lobunikazi bamagama, uphawu, ubuqambi,ilungelo elisemthethweni lobuqambi bemibhalo noma ulwazi,noma lokudlulisa ulwazi oluhambisana nokusetshenziswa kwelungelo lobuqambi bezinto ezithile ezenziwa olwazi lwentela ngokunabile." )
( govza_0007 "Maqondana nayo yonke imibiko engelona iqiniso noma leyo elinga ukuba wumbiko noma equkethwe yilokho okulinga ukuba wumfanekiso" )
( govza_0008 "Noma ingxenye ethathwe embikweni noma esivivinyweni esenziwe nguchwepheshe lapho esho khona ukuthi umbiko noma okuthathwe kuwo kunobuqiniso" )
( govza_0009 "Kanjalo nalapho kuvela ukuthi ozivikelayo wayenezizathu ezinzulu zenkolelo yokuthi kuze kufike isikhathi soku khipha noma ukushicilela umbiko wokukhangisa." )
( govza_0010 "Wayekholwa wukuthi umuntu owenza umbiko wayenekhono elenele, futhi lowo muntu wakhipha imvume edingwa yilo Mthetho ukuba [akhiphe] ashicilele umbiko wokukhangisa" )
( govza_0011 "Noma ethule uhlelo lokudayisa nokuthi akazange ayihoxise leyo mvume ngaphambi kokwethula umbhalo ofanayo wombiko wokukhangisa ngamasheya amasha." )
( govza_0012 "Ukuze amukelwe futhi abhaliswe noma ngolwazi lofakazayo ngaphambi kokwaba noma ukwemukela lesi siphakamiso sokuthenga." )
( govza_0013 "Uma kwenzeka umini waleyonto ehluleka ukwenza lokho okushiwo isaziso singakapheli isikhathi esibalulwe esazisweni leso," )
( govza_0014 "iSigungu seziPhathimandla singenza konke okusemandleni ukuze sisuse noma silahle lowo mkhumbi" )
( govza_0015 "noma into nokubuyiselwa zonke izindleko esingene kuzo kumini noma kulowo muntu;" )
( govza_0016 "nokuthi uma kwahlulekeka ukukhokhwa kwezindleko okukhulunywa ngazo kulesi sigaba emuva kwencwadi ebiza lezo ndleko," )
( govza_0017 "iSigungu seziPhathimandla singathengisa lowo mkhumbi noma leyo mvithi yomkhumbi bese kuthi imali etholakele kulokho kuthengiswa isetshenziswa ukukhokhela izindleko ezingakhokhiwe" )
( govza_0018 "Uma kukhona imali esele iyonikezwa umnini womkhumbi kanti futhi uma ingaphelelanga ukwesula izindleko, leyo esele iyobizwa kumnini noma imuphi omunye umuntu okukhulunywa ngaye kuleso sigaba esifanele." )
( govza_0019 "Siyavumelana nokuthi lesisigatshana, uma kubhekwa zonke izimo ezifanelekile, siphusile futhi sidingekile." )
( govza_0020 "Ukuze kuvikelwe ngokuyikho inhlalakahle yoMqashi kanye noHulumeni weRiphabhuliki yaseNingizimu Afrika." )
( govza_0021 "Nokuthi uma singake siphikisane nokuphusa kwalesisigatshana noma ngasiphi isikhathi, isibopho sokufakazela ukungaphusi kwalesisigatshana kuyoba ngumthwalo waso;" )
( govza_0022 "Futhi siyakuvuma ukuthi singene kule Nkontileka ngokukhululeka kanye nokuzikhethela, nokuthi akukho zimo ezikhona noma ezike zaba khona ezenza ukuba agomele manje" )
( govza_0023 "Noma ngasiphi isikhathi esikhathini esizayo ukuthi sabe sisesimweni esisicindezelayo ukuba sivumele izithiyo ezibekwe kulesisigatshana" )
( govza_0024 "Noma sabe singekho esimweni esilinganayo sokubonisana noMqashi ekuvumeleni lezo zithiyo." )
( govza_0025 "Noma yisiphi isitatimende noma ukungeniswa okuqukethwe kunoma yiyiphi incwadi noma umbhalo ogcinwe yinoma yimuphi umuntu," )
( govza_0026 "Noma imenenja, umphatheli noma umqashwa womuntu onjena, noma otholwa ngaphezu noma kunoma yiliphi igceke elisetshenziswayo." )
( govza_0027 "Noma yiyiphi imoto noma iveseli elisetshenziselwa ibhizinisi yanoma yimuphi umuntu." )
( govza_0028 "Lizawuvunywa njengobufakazi maqondana nomuntu onjena njengokuvunywa kwamaphuzu abekwe phambili kuleso sitatimende." )
( govza_0029 "Noma ukufakwa, ngaphandle kokuthi kufakazelwe ukuthi isitatimende esinje noma ukungeniswa, akuzange kwenziwe ngumuntu onjalo," )
( govza_0030 "Noma umenenja, umphatheli noma umqashwa womuntu onjena ngenkathi esebenza njengemenenja, noma ngenkathi yakhe esesikhungwini noma ngenkathi eqashiwe." )
( govza_0031 "Inkantolo ekhipha isinqumo esiqeda ubuhlobo bomndeni oburejistiwe, maqondana nesondlo nemfundo yengane esadinga ukondliwa." )
( govza_0032 "Okuyingane yobuhlobo bomndeni oburejistiwe, kumbe maqondana nomphathi wayo, kumbe ingane esencane yobuhlobo bomndeni oburejistiwe." )
( govza_0033 "Kumbe ukuyibona ingane, inkantolo ingase ikhiphe isinqumo leso esibona sifanele futhi kwesinye isikhathi, uma ibona kuyinto efanelekile kumntwana ukukwenza lokho." )
( govza_0034 "Ikhiphe isinqumo sokuthi omunye wabazali abe umphathi kumbe umgadi wengane, inkantolo inganquma futhi ukuthi uma kwenzeka omunye wabazali onikezwe ubuphathi yedwa eshona." )
( govza_0035 "Omunye umuntu ngaphandle komzali osaphila, okuzofanele abe umphathi womntwana, yena yedwa kumbe ngokubambisana nomzali osaphila." )
( govza_0036 "Uzothintana nenkantolo ukuthola umyalelo wokukhipha abahlezi ngokungemthetho kumhlaba wombuso ongaphansi kolawulo lwawo." )
( govza_0037 "Inqaba nje, uma amalungelo abahlezi ngokungemthetho engathikamezeki usize abahlezi emhlabeni wombuso ngokungemthetho." )
( govza_0038 "Abadinga nabangenawo umhlaba wolimo ukuthola umhlaba wolimo ofanele usize ezinye iziphathimandla zikahulumeni ukuthola omunye umhlaba ofanele onganikezwa abahlezi ngokungemthetho." )
( govza_0039 "Abadinga izindlu lapho kudingeke khona, nalapho kunezimo ezingavamile, ukusiza abantu bangasese abangabanikazi bomhlaba wolimo." )
( govza_0040 "Umhlaba wabo ongenelwe ngokungemthetho ukususa labo abahlezi kuwo ngokungemthetho abadinga umhlaba wolimo ofanele ukuya komunye umhlaba ofanele." )
( govza_0041 "Noma kunini lapho imvume noma ilayisense yokusebenza enikeza amandla okuthuthela inzuzo." )
( govza_0042 "Ikhomba ukuthi umphathi kumele ahambisane nomgomo wokuthi ukuthutha kumele kwenzeke ngendlela evunywe noma ebekwe yi Bhodi," )
( govza_0043 "lowomphathi welayisense yokusebenza angakwazi ukuthi kuthi ngemuva kokukhuphuka kwentengo ka phethilomu e kwi Riphabhuliki, akhuphule intela ngenani elithile." )
( govza_0044 "Kodwa kungabi ngaphezu kwamaphesenti angu 10, uma kuthi kungakapheli izinsuku ezingu 10 ngemuva kokwenyuka kwentela kanjalo." )
( govza_0045 "Umphathi welayisene afake isicelo kwi Bhodi sokuthi kwenziwe ushintsho olufanele kuleyo mvume noma ilayisense yokusebenza ngaphansi kwalo Mthetho." )
( govza_0046 "Udinga usizo ngesikhathi ulindele uxhaso lwesondlo sengane." )
( govza_0047 "Ngesikhathi uhulumeni esabhekana nesicelo kwenzeke inhlekekele ephuthumayo, enjengokusha kwendlu yakho." )
( govza_0048 "Awukufanelanga ukuthola uxhaso lukahulumeni nakhona ukusimo sokuxakeka kakhulu awukwazi ukusebenza ngenxa yokuthi impilo yakho ayikuvumeli." )
( govza_0049 "Lokhu kusho ukuthi ugula isikhathi esingaphansi kwezinyanga eziyisithupha awukwazi ukuthola isondlo sengane." )
( govza_0050 "Noma izingane zakho komunye umzali wengane owondla umndeni ushonile, owondla umndeni usejele okwesikhashana uphazanyiswe yinhlekelele." )
( govza_0051 "Kodwa indawo yakini noma umphakathi wakini awumenyezelwanga njengendawo yenhlekelele." )
( govza_0052 "Libe nemithombo emibili ezimele elondoloze amandla namathuba okukhetha enye yemithombo." )
( govza_0053 "Okungenani eyodwa esebenzisa isifutho esiqhutshwa yinjini noma ijeneleyitha okuyizinto zombili ezinamandla adingekayo ukuhambisa yonke imishini engaphakathi yokuhambisa indiza." )
( govza_0054 "N-oma isifutho ngolunye uhlobo lwamandla, isifutho siyofakwa ngendlela yokuthi ukwehluleka komshini owodwa kungaphazamisi amandla aphakelwayo, kanjalo nokufinyelela kweminye imishini edinga amandla ngaphandle kwesimo sikajikamanzi othwala kuphela impahla ongase uvunyelwe umthombo wamandla oxhunywe kuphela ukubhekana nenkomba yokujika amandikhetha." )
( govza_0055 "Akukho Mbuso noma ilungu noma isisebenzi esinesibopho (ngaphandle kwalapho kunesenzo sangamabomu noma ukungenziwa ohlangothini lwalelo lungu) kunoma yimuphi umuntu osebenzisa ngaphandle kokugunyazwa noma yisiphi isithuthi, indiza noma umkhumbi ongaphansi kwezandla zoMnyango, noma kunoma yimuphi umuntu owondliwa yilowo muntu onje, ngokulahleka noma umonakalo empahleni okubangwe ukulimala komzimba, ukulahleka kwempilo noma ukulahleka noma umonakalo ezimpahleni okubangwe noma okuvela noma okuxhumene ngandlela thize nokusetshenziswa kwesithuthi, indiza yezinto ezisetshenziswayo noma umkhumbi." )
( govza_0056 "Ukuze kulawulwe ngendlela ehlelekile nehambisana nemithetho uHlelo lukaZwelonke lwezeMpilo lweRiphabhuliki yaseNingizimu Afrika nangokuhambisana nezibopho ngokomthetho nangokomthethosisekelo kohulumeni kazwelonke, bezifundazwe, nabasekhaya malungana nosizo lwezempilo; ukuze kwenekwe kahle amalungelo nemisebenzi yabasebenzisi boHlelo lukaZwelonke lwezeMpilo kanye nalabo abahlinzeka ngosizo lwezempilo abasebenza ngaphansi kwalolu hlelo; ukuze kubhekelwe imvume enokwaziseka yabasebenzisi bohlelo kanye nokugcinwa kwemfihlo yemininingwane yabasebenzisi bohlelo; ukusungula izinhlaka ezingeni likazwelonke ukuthuthukisa nokwenza lula umsebenzi nokuqinisekisa izinga eliphakeme lezinhlelo ezibhekela usizo lwezempilo kanye nokweluleka uNgqongqoshe ngokuphathelene nemigomo yezempilo nangamasu ezempilo kazwelonke; ukubhekela ukwethulwa kwamasu ezempilo kazwelonke ukuze uMnyango wezeMpilo kaZwelonke uyenze ngemfanelo imisebenzi yawo; ukusungula izinhlaka zasesifundazweni ezizokusiza zithuthukise ukulethwa kwezinsizakalo zezempilo ezifundazweni nokweluleka UNgqongqoshe wezeMpilo wesiFunda ngokuphathelene nemigomo yezempilo namasu kazwelonke ezempilo; ukubhekela ukwethulwa kwamasu ezempilo esifunda ukuze ambandakanywe nesu lezempilo likazwelonke; ukusungula Uhlelo LwezeMpilo LwesiFunda okuzothi ngalo indawo yaseRiphabhuliki yaseNingizimu Afrika yahlukaniswe ngeziFunda zezeMpilo; ukuhlinzekela ukuphathwa nokwengamelwa kwezifunda zezempilo kanye nezifunda ezingaphansi kwazo kubuye kuhlinzekwe nosizo lwezempilo lwesifunda ngomasipala; ukuze kubhekelwe ukulungiswa kwamasu ezempilo zesifunda; ukulawula izizinda zezempilo ngokuhambisana nohlelo lokuhlunga nezitifiketi zesidingo nokwenza amasu okuhambisa nokulandelwa komthetho; ukubhekela nokulawula ukwethula kwezinsazakalo kuzizinda zezempilo zikahulumeni nezangasese, emitholampilo nasezingosini zezempilo zomphakathi nasezindaweni ezingesizona izizinda zezempilo; ukubhekela izibopho ezithize kuzizinda zezempilo zangasese; ukwakha amasu nezindlela zokumisa izimfuno namazinga aphezulu; ukubhekela intuthuko nokusatshalaliswa kwemithombo yabasebenzi ngaphakathi koHlelo lukaZwelonke lwezeMpilo; ukwakha isigcawu semikhandlu esemthethweni yawochwepheshe bezempilo kanye nokumiswa kwezizinda zokwelapha nokuqeqesha, amakomidi azo okudidiyela nomkhandlu kazwelonke wezizinda ezihlanganyele zokwelapha nokuqeqesha; ukuhlinzekela uhlelo lukaZwelonke lokwethekela ngegazi; ukulawula ukutholakala, ukugcinwa, nokusetshenziswa kwezicubu, igazi, umkhiqizo wegazi, nezakha bulili kubantu, kanye nokunikelwa nokufakelwa kwezitho nezicubu; ukuvimbela ukudalwa kwabantu ngobuchwepheshe nokulawula ucwaningo oluphathelene nezakhamuntu nemibungu; ukubhekela ukuhlolwa kwezidumbu nokulawulwa kwakho konke okuphathelene nezicubu, izitho, igazi, umkhiqizo wegazi, kanye nezakhabulili; ukwakha ikomidi likaZwelonke lokucwaninga ngezeMpilo kanye nezindlela zokunquma ngamaphuzu amqoka ocwaningo; ukwakha UMkhandlu kaZwelonke obhekele iqophelo eliphezulu kanye nehhovisi elibhekele ukuhambisana namazinga abekiwe; ukusungula UMkhandlu kaZwelonke obhekele ukulunga kocwaningo lwezeMpilo nokubhekela uhlelo lukaZwelonke lokwazisa ngezeMpilo; ukuyalela ngemisebenzi nezibopho zabaphathiswa bezempilo kanye nezinkambiso zokuhlola; ukubhekela izimiso migomo eziqondene nezempilo; nokubhekela okuxhumene nalokhu." )
( govza_0057 "Ukuguqula Umthetho Wesikhashana Wezithuthi Ezihamba Phansi Kazwelonke ukuze kuchazwe imishwana kanye nokuguqula izincazelo ezithile ukwandisa ulwazi okungenzeka ukuthi lufakwe ezazisweni eziqukethwe yinqubomgomo yezithuthi Ezihamba Phansi Kazwelonke; ukunikeza kabusha ukulunganiswa kwenqubo yokuhlelaYiziphathimandla zokuhlela yiziphathimandla; ukwehlisa inani lezinhlelo ezidingwa nguMthetho; ukunikeza uNgqongqoshe Amandla okukhetha iziphathimandla zokuhlela okumele zinikeze izinhlelo zezithuthi ebhodini lezifundazwe elifanele; ukunikeza kabusha ukulungiselelwa kohlaka oluyisu lwezithuthi ezihamba phansi lukazwelonke kanye nezinhlaka eziyisu zezithuthi ezihamba phansi zezifundazwe; ukuchitha imibandela ngokuphathelene namarekhodi amanje ezithuthi zomphakathi; amasu amalayisense asebenzayo, izinhlelo zokunikeza umqondo othile kanye nezinhlelo zezithuthi zomphakathi; mukunikeza kabusha ukulungiselela izinhlelo zezithuthi zomphakathi; ukunikeza kabusha ukulungiselela izinhlelo zezithuthi ezihlanganisiwe; ukwengeza imikhawulo ethile yesikhathi; ukunikeza kabusha ezinhlotsheni ezintsha zezimoto ezingasetshenziselwa izinsiza zokuba yizithuthi zomphakathi; ukwengeza ukukhishwa kokuphathwa kwamalayisense asetshenziswayo, ukwengeza imisebenzi yabaphathi bamalayisense okusebenzisa amaphemithi; ukucacisa izimoto ezingasetshenziswa ekwenziweni kohambo oluya kude; ukunikezwa kabusha ukuguqulwa kwamalayisense okusebenzisa; ukunikeza uNgqongqoshe amandla okubeka amazinga amamitha avaliwe kumatekisi asebenzisa amamitha avaliwe kumatekisi asebenzisa amamitha kanye nokunikeza ama-MEC amandla okuthola izakhiwo zenkokhelo zamatekisi asebenzisa amamitha, ukwenza imibandela yokunikeza amalayisense okusebenza ezinsiza zezivakashi; ukunikeza kabusha ukubeka endaweni yokuthile okwesikhashana kwezimoto ezicacile; ukwakha amacala amasha; kanye nokwenza izilingiso zemibhalo; ukunikeza izindaba ezihlangene nako loku." )
( govza_0058 "Amakomiti ewadi ukwenabisa ukubamba iqhaza kwabahli bendawo ekuthathweni kwezinqumo kumasipala, njengoba kuyibona abanokuxhumana nomkhandlu ngendlela eqondile noma neyehlukile bangabameli bewadi yendawo abeseki qembu kwezepolitiki kumele babambe iqhaza odabeni olunjengohlelo lokuhlelela intithuko ehlanganisayo, ukuphathwa kokusebenza kukamasipala, uhlelo lwezimali lonyaka, imisebenzi yomkhandlu kanye neminye imisebenzi nezinhlelo ezisemqoka njengoba zonke lezi zinto zinomthelela ebantwini bendawo ukubona nokuqalisa imisebenzi ngenhloso yokwenza ngcono izimpilo zabantu ewadini angeseka ikhansela ekusombululweni kwezinkinga, ukunikeza ulwazi ngokusebenza kukamasipala angabheka ukusebenza kukamasipala abuye aphakamise udaba olukhathaza amawadi wendawo angasiza emikhankasweni yokuqhwashisa umphakathi, isib. inkunkuma, amanzi kanye nenyendle, ukukhokhelwa kwezinsiza njengoba amalunga azi imiphakathi yawo kanye nezidingo zawo." )
( govza_0059 "Imininingwane ye-asosiyesheni yokuvimbela imililo eyenza isicelo imininingwane yomuntu oqala inqubo yobhaliso lwe-asosiyesheni yokuvimbela imililo eyenza isicelo sokubhaliswa isiqinisekiso sokuthi akukho mnikazi oye akangabandakanywa ngamabomu emihlanganweni noma ezingxoxweni maqondana nolwazi lwe-asosiyesheni yezivimbela mililo imininingwane ngendawo i-asosiyesheni yezivimbela mililo eyenza isicelo enegunya kuyo isiqinisekiso sokuthi ayikho enye i-asosiyesheni yezivimbela mililo enenhloso yokusungula lapho noma ekhona kuleyo ndawo lapho le asosiyesheni eyenza isicelo sakhona isiqinisekiso somuntu osungula ukubunjwa kwe-asosiyesheni yokuvimbela imililo isincomo ngofanele omele uhulumeni wendawo isincomo ngomele ihhovisi lesifunda lobomnyango wezamanzi namahlathi isiqinisekiso ngomqondisi ophezulu wesifunda waboMnyango wezaManzi namaHlathi." )
( govza_0060 "Uma umuntu, ngaphandle komuntu okhangisa ngemininingwane yohlobo noma yokwenza ngemfanelo kwesilwane," )
( govza_0061 "ethengisa isilwane noma okokwenza kwamajini kwaso noma eqokelela isidoda, eqoqa umbungu," )
( govza_0062 "ukubelethisa okwenziwayo noma edlulisa imbewu yowesifazane noma imibungu kusilwane" )
( govza_0063 "noma izilwane zezinsikazi ezamukelayo, isikhangiso esingamanga esiphathelene nazo," )
( govza_0064 "uzawubekwa icala lokweqa umthetho osesigabeni esingaphansi kwe-1," )
( govza_0065 "kuzawuba ukuzivikela okwanele uma enobufakazi bokuthi wayengazi noma akalindelekile ukuthi kungenzeka ukuthi uyazi ukuthi isikhangisi sasingamanga" )
( govza_0066 "noma sasiholela ophathe ngandlela thize, ngaphandle kokuthi kufakazelwe ukuthi obekwa icala wehluleka ngenkathi ephoqelelwa ngobhalisayo" )
( govza_0067 "noma iphoyisa lomthetho ukunikeza igama kanye nekheli laloyo muntu okwakukhingiselwa noma kusabaliselwa yena." )
( govza_0068 "Uma ikomiti eliphathekayo esigabeni esingaphansi kwe-1," )
( govza_0069 "lithola ukuthi umphakathi wabafuyi bezilwane noma isiphathimandla esibhalisayo esiphathekayo" )
( govza_0070 "asitholanga ngokufanele noma kungenzeka ukuthi singatholi ngokufanele izinjongo ezicaciswe kusigaba esingaphansi kwe-1," )
( govza_0071 "uNgqongqoshe angakusula ukubhaliswa komphakathi wokufuya izilwane" )
( govza_0072 "noma isiphathimandla esibhalisayo noma ayilengise isikhathi esibekwa nguye," )
( govza_0073 "lapho amandla omphakathi wokufuya izilwane noma isiphathimandla esibhalisayo azawulengiswa noma," )
( govza_0074 "uma kumiswa ukuzibhalisa, ngokuhambisanayo anikeze amandla okwesikhashana kusiphathimandla esizibhalisayo esiphathekayo" )
( govza_0075 "noma ngokungasaguquki kwesinye isiphathimandla esizibhalisayo nguNgqongqoshe, kuye ngesehlakalo ngasinye." )
( govza_0076 "Umbiko wakuqala wesimo sesigulane wesifo esibagwe ngumsebenzi" )
( govza_0077 "isicelo sesincephezelo sesifo esibangwe ngumsebenzi, ifomu elilandisa ukusebenzela endaweni ethile ebange isifo," )
( govza_0078 "imibiko yesimo sesigulane,sizesiphole isigulane" )
( govza_0079 "umbiko wokugcina kadokodela wesifo esibangwe ngumsebenzi." )
( govza_0080 "uma isigulane sesipholile incwadi yokupopola izindlebe, uma umsebenzi eye wagcina eyisithulu angasezwa ezindlebeni ngenxa yokusebenza endaweni enomsindo kakhulu" )
( govza_0081 "i-ENT okuyiripoti esipeshela ezohambisana nencwadi yokupopola izindlebe uma kudingekile," )
( govza_0082 "umbiko wokusebenza kwamaphaphu uma isifo singesamaphaphu, umbiko wesikhumba uma isifo singesesikhumba," )
( govza_0083 "umbiko wokusebenza kwegazi, kwamathe, isikhohlela ieksireyi kanye nokunye nje." )
( govza_0084 "Lapho isicelo nganoma yimuphi umsebenzi odinga imvume yezemvelo ngokwale mithetho" )
( govza_0085 "kumele senziwe ngokweminye imithetho nokuthi eminye imithetho idinga ukuthi, ulwazi kumele lungeniswe" )
( govza_0086 "noma izinhlelo kumele zilandelwe ngokugcwele nolwazi noma izinhlelo ezidingekayo ngokwale mithetho," )
( govza_0087 "uNgqongqoshe noma umphathi womnyango kahulumeni wesifunda, ngokunikezela ngeSahluko 3 somthethosisekelo kanye nesigaba 24 (g) somthetho," )
( govza_0088 "kumele athathe izinyathelo zokwenza isivumelwano esibhaliwe nesiphathimandla esibhekene nokuphathwa komthetho ophathelene nokuhanjiswa kwezidingo zomgomo nale mithetho" )
( govza_0089 "ukuze kugwemeke ukuphindaphindeka ekufakweni kwalolo lwazi noma ekwenziweni kwalezo zinhlelo." )
( govza_0090 "Ukuchibiyela uMthethosivivinywa waseGauteng weNgqalasizinda yezokuThutha, ka-2001," )
( govza_0091 "ukuze kuchitshiyelwe futhi kufakwe nezincazelo ezithize;" )
( govza_0092 "ukuhlinzeka ngamalungelo okusetshenziswa komhlaba adingekile maqondana neziteshi kanye namandla adingekayo ka-MEC" )
( govza_0093 "ukuze akwazi ukwenza izivumelwano zamaphrojekthi yemigwaqo nemizila kaloliwe;" )
( govza_0094 "ukuchibiyela inqubo maqondana nokushiwo kwendlela; ukwenza ucwaningo lwesibili ngendawo esigabeni sokwenziwa kohlelo lokuqala lomgwaqo" )
( govza_0095 "noma lomzila wesitimela okungadingekile" )
( govza_0096 "lapho isiphathimandla esikwazi umsebenzi waso ngezendawo sinquma ukuthi ucwaningo ngendawo kulesi sigaba sokushiwo kwendlela kubalulekile;" )
( govza_0097 "kanye nokuhlinzeka ngezindaba ezincane." )
( govza_0098 "Ukukhuthaza ukutholakala ngesikhathi nokwenziwa-ngcono kwezinto ezisetshenziswa emancwebeni" )
( govza_0099 "ukuze kwaneliswe izimfuno nokulindelwe ngabasebenzisi bamaChweba, qinisekise ngokuqophisana ngokwebhizinisi okufanele phakathi kwalabo abasebenza emancwebeni" )
( govza_0100 "nalabo abaletha usizo emancwebeni siqinisekise ukuthi iSigungu seziPhathimandla zamaChweba kuZwelonke zinikeza usizo olusezingeni elifanele" )
( govza_0101 "nokuthi ziyahambisana namazinga amukelekile emhlabeni-jikelele sixhumane neminyango kahulumeni" )
( govza_0102 "neminye imigwamanda nezikhungo mayelana nezindaba ezibalulekile emkhakheni wezamaChweba," )
( govza_0103 "nokuthi siqoqe futhi sigcine ulwazi mayelana nemisebenzi yeSigungu seziPhathimandla zamaChweba kuZwelonke." )
( govza_0104 "Awukho umbiko wokukhangisa ngamasheya oqukethe umbiko othi, wonke noma ingxenye yamasheya adayiselwa umphakathi esekiwe" )
( govza_0105 "noma angase asekwe oyomukelwa noma ubhaliswe, ngaphambi kokuba umbiko ofanayo wesivumelwane sokweseka, nesifungo somuntu ovele njengomesekeli" )
( govza_0106 "noma uma kuyinkampani, umbiko ovela kubaqondisi ababili baleyo nkampani," )
( govza_0107 "uma leyo nkampani inomqondisi oyedwa,yilowo mqondisi, echaza ukuthi ngolwazi analo nenkolelo," )
( govza_0108 "oseka ukudayiswa kwamasheya emphakathini, unamandla okufeza izibophezelo azethembisile" )
( govza_0109 "uma kwenzeka amasheya engathengwa muntu noma singathengwa isibalo esidingekayo," )
( govza_0110 "umbiko uyoqhubeka nokushicilelwa kwiSigungu Semisebenzi Yezimali nakumlawuli-sikhungo." )
( govza_0111 "Akekho umuntu ophathekayo esigabeni esingaphansi kwe-1 ozawukhangisa ukuthi, uzalo oluzoba khona ekusetshenzisweni kokokwenza kwamajini" )
( govza_0112 "okunje ozakurekhoda noma ababhalise ngokuphathelene nanoma yimaphi amazinga emfuyo," )
( govza_0113 "ngaphandle kokuthi umphakathi wabafuyi bezilwane ophathelene nezilwane lezi inzalo etholakele ingeyawo," )
( govza_0114 "inikeza imvume yangaphambilini ngokubhala ukuthi okokwenza kwamajini okunje kuqokelelwe encwadini yezilwane yamasitadi yemfuyo ecacile" )
( govza_0115 "kanti futhi inzalo etholakalayo enjena ingafaneleka ukurekhodwa noma ukubhaliswa encwadini yomhlambi egcinwa isiphathimandla esibhalisayo yalolo hlobo lwesilwane" )
( govza_0116 "noma imfuyo ecacisiwe yohlobo olunje lwesilwane." )
( govza_0117 "Lokhu kufakwa kwabesifazane ekwenzeni izinqumo, kuyilungelo ngqangi labantu." )
( govza_0118 "abesifazane kumele babambe iqhaza ekwenzeni umthetho ngoba ukuqaliswa kwemithetho kanye nemigomo kahulumeni inomthelela ezimpilweni zabo zazonke izinsuku." )
( govza_0119 "okubaluleke kakhulu ukuthi, ucwaningo selukhombisile ukuthi, uma abesifazane bebamba iqhaza ekuthathweni kwezinqumo, kuholela ekwenyukeni kokubhekwa ngqo kanye nasekwabiweni kwezinsiza ezenza ngcono izinga lempilo labantu bonke." )
( govza_0120 "Ukunyuka kokubamba iqhaza kwabesifazane ekwenzeni umthetho, kungelulwa kuholele ekwenziweni ngcono kokufinyelela kwizinsiza eziyisisekelo ezifana nezezindlu, ezemfundo kanye nezenhlalakahle." )
( govza_0121 "Ukuqinisekisa ukuthi umsebenzi wombhali kawulahleki nanini, futhi uyatholakala uma kwenziwa ucwaningo ezikhathini ezizayo, siyakwazi isizinda ukuqwashisa bonke abasebenzisi balezi zizinda ngokukhiqiziwe" )
( govza_0122 "nokushicilelwe kuba yisisekelo sokwakhiwa kwemiqulu yezinhla zemibhalo kazwelonke" )
( govza_0123 "neminye amaqoqo olwazi aqwashisa abasebenzisi-sizinda kanye nabasazozisebenzisa kuzwelonke nasemhlabeni wonke ngezincwadi ezikhona neminye imibhalo," )
( govza_0124 "kanjalo lokho kukhuthaze ukusatshalaliswa nokuthengwa kwayo iba yisisekelo sokuqoqwa kwezibalo ezikhiqizwe i-UNESCO emhlabeni wonke okungumthombo oyigugu wolwazi lwezamabhizinisi embonini nohwebo lwezincwadi." )
( govza_0125 "Amaphutha efomini lesicelo: Isicelo sinephutha uma umenzi wesicelo engazange asayine isifungo, noma uma isifungo somenzi wesicelo singazange sifakazelwe nguKhomishane Wezifungo, noma uma isicelo esingaphezu kwesisodwa samukelwa kumenzi wesicelo ukuze athole ilungelo lokudoba uhlobo olufanayo lwezinhlanzi, noma uma umenzi wesicelo ehlinzeke ngokwaziswa okungelona iqiniso noma izincwadi ezingelona iqiniso, noma ehlulekile ukudalula ukwaziswa okudingekayo, noma ezame ukuthonya uNgqongqonshe noma isikhulu esiphathisiwe ngokusebenzisa izindlela ezingqubuzanayo nalezo ezihlinzekwe kwiNqubomgomo Evamile ngenkathi yokwenziwa kwesicelo." )
( govza_0126 "Ukuze kubonakale ukuthi imibandela yelayisensi iyalandelwa, noma imuphi umuntu ogunyazwe yiSigungu seziPhathimandla ngokubhaliwe," )
( govza_0127 "angangena emangcekeni lapho kusebenzela khona lowo ogunyazwe ngelayisense, ngezikhathi zomsebenzi," )
( govza_0128 "engaphethe ncwadi yokusesha, ukuze ahlole noma imuphi umsebenzi owenziwayo," )
( govza_0129 "isakhiwo nezinto zokusebenza, futhi angacela lowo muntu ogunyazwe yilayisensi ukuba aveze izincwadi, amarekhodi, izitatimende noma amanye amabhuku aphathelene nezindaba okukhulunywa ngazo kuloMthetho" )
( govza_0130 "ukuze azihlole noma ukuze enze imifanekiso yalezo zincwadi ayithathe." )
( govza_0131 "Kumele ukuthi nganganokuthi kungenzeka, avuselele indawo yokuphila ethintwe ukuhlola ubukhona bokunga mayinwa" )
( govza_0132 "noma umsebenzi wokumayina esimweni sayo semvelo, noma leso esiyokhonjwa noma ekusetshenzisweni komhlaba okuhambelana nemimisomigomo eyamukeleka ngokwejwayelekile yokuthuthukisa okugcinekayo;" )
( govza_0133 "futhi nguye omelene nokulimala kwendawo yokuphila, ukungcolisa noma ukucekela phansi imvelo ngenxa yokumayina kwakhe" )
( govza_0134 "ngokukuhlola ubukhona bokunga mayinwa noma umsebenzi wokumayina futhi okungenzeka ngaphakathi noma ngaphandle kwemingcele yendawo analeli," )
( govza_0135 "imvume noma ukukunyelwa kuyo." )
( govza_0136 "Ukubuyekeza inqubekela-phambili eyenziwe mayelana nezinguquko ngokubheka ubuhlakani bamaqhinga," )
( govza_0137 "izinhlelo nenqubo esetshenzisiwe ukudweba isiphakamiso soguquko sokuhlahla indlela," )
( govza_0138 "ukubeka izinhloso-nqangi ngokuthathela ohlaziyweni lwenqubekela-phambili" )
( govza_0139 "noma ekwehlulekeni kwayo ukucubungula ukuthi ama-workshops ngabe abe yimpumelelo yini ekunxenxeni nokuthola ekwesekweni yizigaba ezahlukene zoguquko" )
( govza_0140 "njengoba kuhlose imigomo nomthetho kahulumeni ukuphenya ukuthi izindlela zokusabalalisa imibiko" )
( govza_0141 "ngezinhloso zoguquko nenqubo yonkana, kubonakala njengokuyikho yini emehlweni abasebenzi." )
( govza_0142 "Ummangalelwa waziswa ngelungelo lakhe lokuthi, avele phambi kweMantshi enkantolo yase ... usuku ... okufanele avele ngaso," )
( govza_0143 "inyanga okufanele avele ngayo, unyaka, isikhathi: ukugamanxa kwehora lesishiyagalombili ekuseni, ukuze azochazela inkantolo ukuba kungani inkantolo ingeze yamphoqa okokugcina ngci ngomyalelo wokuvikela wesikhashana;" )
( govza_0144 "futhi uyaziswa nangelungelo lakhe lokuthi udaba lwakhe lulalelwe ngosuku olungaqhelile kakhulu emahoreni angamashumi amabili" )
( govza_0145 "emva nje kokuba inkantolo kanye nommangali benikwe isaziso esibhaliwe." )
( govza_0146 "Kumele lenze uvivinyo noma uhlolo, olubekwa nguKhomishana kaZwelonke wamaPhoyisa," )
( govza_0147 "okungenani abe nesitifikedi sebanga eliphezulu,noma esilingana naso," )
( govza_0148 "kanye nokunikeza ubufakazi balokhu akwazi ukukhuluma, ukubhala kanye nokufunda isingesi," )
( govza_0149 "njengolunye lwezilimi ezigunyazwe wumthetho, avume ukuthi kugxivizwe iminwe yakhe ukuze iyohlolwa" )
( govza_0150 "nakhona angatholakali enecala noma engumuntu oshishiselwa icala azimisele ukuqeqeshwa" )
( govza_0151 "azimisele ukuthatha isifungo sehhovisi, angabi nawo ama-tattoo abonakalayo; kanti abe nelayisense yokushayela, noma-ke lokhu kungesona isidingo sokuqala sokuba yirizevu." )
( govza_0152 "Umshayeli webhanoyi elithwala abantu eliqondwe wumgonyana, ngeke alisebenzise ngaphansi kwe-IMC" )
( govza_0153 "noma alindizise lishiye amafu ngebanga lengxenye yokuthathu kokuyisishagalolunye ngaphandle," )
( govza_0154 "uma isibikezelo sezulu noma sakamuva siveza ukuthi kufanele ahambe ngendlela ethile ehlukile kuleyo ehleliwe ngesikhathi lisuka" )
( govza_0155 "noma liyohlala ibhanoyi kodwa abhekele imibandela yomgomo [numbers deleted] , agcine ibanga nokuphakama okufanele nokunqunywe ngaphansi komgomo [numbers deleted]" )
( govza_0156 "nokubikezelwa kwesimo sezulu esingeke siguquke, okungenani isikhathi esiyihora ngaphambi kokufinyelela lapho liya khona ibhanoyi." )
( govza_0157 "Ukuze kubonakale kahle ukuvuselelwa komthetho eCanada, kwaqalwa iprojekthi yoMkhandlu womphakathi," )
( govza_0158 "eyayinezinhloso zokubuyisela emuva ukulethwa konswinyo olwalungafanele ezimpilweni zalabo ababevele bengabhekelelwe wumthetho," )
( govza_0159 "ukuvimbela imithelela esindayo nefundisa ngobugebengu obukhulu basetilongweni," )
( govza_0160 "lokhu kunika izindlela eziningi ezehlukile ezingasiza kulabo abathatha izinqumo ukuze bakhethe kuzo," )
( govza_0161 "zihlinzeke imithetho eyanelisayo kwabahlukumezekile nasemiphakathini ukuze kubhekwane nezinto ezithinta umphakathi," )
( govza_0162 "ezomnotho nezangasese okuhlobene namacala angaba nezigwebo zokukhokhwa kwemali." )
( govza_0163 "Zonke izaziso eziyonikezelwa ngokwezimiselo zale Nkontileka, ziyokwenziwa ngokubhalwa;" )
( govza_0164 "futhi ziyokwethulwa siqu noma zithunyelwe ngeposi elikhokhelwe labhaliswa;" )
( govza_0165 "futhi uma zethulwe siqu, zithathwe ngokuthi zitholakale ngelanga lokwethulwa kwazo;" )
( govza_0166 "noma uma zithunyelwe ngeposi elikhokhelwe labhaliswa, lithathwe ngokuthi zitholakale ezinsukwini ezintathu zokusebenza emva kokuposwa" )
( govza_0167 "ngaphandle uma kungenjalo futhi kunesiqinisekiso; noma uma zithunyelwe ngefeksi, zithathwe ngokuthi zitholakele osukwini lokuqala lokusebenza" )
( govza_0168 "osukwini olulandela ukuthunyelwa kwefeksi ngaphandle uma kungenjalo futhi kunesiqinisekiso." )
( govza_0169 "U-MEC unelungelo lokufaka isicelo sokuphikisa isinqumo, zingakapheli izinsuku ezingamashumi amabi nesishiyagalombili ethole isinqumo" )
( govza_0170 "nezizathu zokwamukela isicelo, ngokuhambisa ngenqubo ebekwe kumthetho ofanele futhi esenze ushintsho oludingekayo," )
( govza_0171 "asifake kwisiphathimandla noma umkhandlu wokwedlulisela izikhalo ohlinzekwe kumthetho ofanele," )
( govza_0172 "uma kungukuthi umthetho ofanele ubeka ukuthi kufakwe izikhalo kuNdunankulu, noma iliphi ilungu leKomidi ePhakeme," )
( govza_0173 "oMele uHulumeni kwisiFundazwe, isikhalo kumele silalelwe bese siphelela kwiBhodi laMalokishi lesiFundazwe" )
( govza_0174 "ngokungathi leloBhodi laMalokishi linezwi lokugcina lendawo yomthetho mayelana nesikhalo." )
( govza_0175 "Okokugcina, bengifisa ukuba bonke abasebenzela iSizwe baqiniseke ukuba, ukuziphatha okufanele kuvumelana nendlela eyamukelekile yokubusa nokuphatha umphakathi, nokuthi bazijwayeze umkhuba wokuziphatha ngendlela efanele kanye nale ncwadi echazayo." )
( govza_0176 "Kufanele kubhekelelwe ngesikhathi kuhlelwa ukuthi, isikhathi sokulinda singathatha okungenani izinyanga ezintathu," )
( govza_0177 "futhi kufanele kuqikelelwe uma kugcwaliswa ifomu ukuba, ligcwaliswa ngendlela ukuvimbela ukubambezeleka kwesikhathi eside." )
( govza_0178 "Somlomo, ukuze kube khona imiphumela yesimo sempilo engcono, kufanele zonke izingxenye zomphakathi wasezweni, zibambisane ekuzameni ukufinyelela enhlosweni yokwenza isimo sempilo sibe ngcono." )
( govza_0179 "Okufanele kucace ukuthi, isitatimende esibukeziwe sohlelo lwezifundo sikazwelonke asilona uhlelo lwezifundo olusha, kodwa senzelwe ukuhlela nokuqinisa kabusha uhlelo lwezifundo lwezi-nkulungwane ezimbilii nesihlanu." )
( govza_0180 "bese siqinisekisa ukuthi imigomo nezinhloso zemfundo esekelwe phezu kwemiphumela yezifundo ziyaphumelela." )
( govza_0181 "Umfundi uzokwazi ukuthi alalele ukuze athole ulwazi, nokuthi akwazi ukujabulela leyo nto asuke eyilalele, nokuthi akwazi ukubhekana nezimo ezahlukahlukene zempilo angahle ahlangabezane nazo." )
( govza_0182 "Isamba umasipalati angase asibuyise kulowo oqashile, akufanele sibe ngaphezulu kwemali yokuqasha noma enye imali okufanele ikhokhwe yilowo oqashile, noma ohleli endlini eyikhokhela umnikazi wendlu." )
( govza_0183 "Isikhathi sesithathu simele inani lilonke lentela, okumele ikhokhelwe kunyaka ogcwele, kususwe intela yabasebenzi ekhokhiwe yonyaka ophelele, noma yiyiphi enye intela yangaphandle evunyelwe kunyaka ophelele." )
( govza_0184 "amanani akhokhiwe esikhathini sentela yesikhashana yokuqala neyesibili." )
( govza_0185 "Ungqongqoshe owengamele ezokuthutha esifundazweni noma umkhandlu wasekhaya, ungakhipha isaziso esibhaliwe usiqondise kumnini noma kothile ohlala endaweni okubekwe kuyo uphawu." )
( govza_0186 "noma isici esisithe uphawu lomgwaqo ukuba asuse lolo phawu noma into ephazamisayo, singakapheli isikhathi esinqunywe esazisweni." )
( govza_0187 "Lama thimba angenhla afakiwe kanti ahlinzekelwe kakhulu yisigaba soMthethosisekelo esingenhla" )
( govza_0188 "ngokunjalo miningi imithetho eshayelwe ukuwavikela ngendlela enqunywe kuMthethosisekelo wamanje, ophoqa ukuqoshwa koMthetho weMvelo owakhelwe ukuqinisekisa ilungelo." )
( govza_0189 "Njengoba umthetho kazwelonke ufuna ukuthi, amajaji nezimantshi, bathathe izifungo zokwenza imisebenzi yabo ngaphambi kwenkantolo yemantshi, endaweni lapho inkantolo yendabuko inamandla okulalela amacala khona." )
( govza_0190 "Uhlulekile ukuhlangabezana noma ukufeza izinhlelo ezimayelana nokuqedwa kokusetshenziswa kweziphuzo ezidakayo ngokweqile, noma ephule umgomo wokuziphatha futhi, ehluleka ukunika izizathu ezizwakalayo zokwehluleka ukwenza lokho." )
( govza_0191 "Isisindo sendiza engalayishile kufanele sinqunywe ngokusebenzisa ubuchwepheshe bokukala, noma isikali sesisindo yinhlangano elungisayo enolwazi olufanele lokulungisa izindiza, noma ngumuntu omukelwe nguKhomishani." )
( govza_0192 "Lokhu kumbandakanya, umgomo wokuxazulula ukushayisana kwezifiso okuhloswe ngakho ukugwema isimo, lapho ilunga noma esinye sezisebenzi esingatholakala sesizuza okuthile, ngenxa yesikhundla noma ukusebenzela inhlangano." )
( govza_0193 "Ilunga lomndeni wengane elifake kumabhalane wenkantolo yeZingane," )
( govza_0194 "isaziso sentshisekelo yokuthola ingane, ngaphambi kokuthola ingane, linelungelo lokucatshangwa njengomzali onganikwa ingane, lapho sesiphumile isinqumo sokuthi ingane ingatholwa." )
( govza_0195 "Iphoyisa lingabopha ngaphandle kwencwadi eligunyazayo noma yimuphi ummangalelwa endaweni lapho okwehlakale khona udlame lomndeni, noma lowo elimsola ngokuthi wenze isenzo noma icala eliphathelene nodlame lomndeni kummangali." )
( govza_0196 "Imiqulu elondoloze ulwazi iphelelwe yisikhathi, kanti abaphathi bazizwe becindezelekile ngesizathu sokuthi, ulwazi abanalo lusalele ngemuva futhi aluqhathaniseki kahle nolwazi lwesikhathi samanje." )
( govza_0197 "Isimo esibhekene naso kanye nemisebenzi esizinikeze wona sidinga ukuthi, sivuse ugqozi kubantu, sibahlanganise babe munye ukuze kwenziwe zonke izinto okumele zenziwe, singakhohlwa ukuthi sonke kanye kanye siphethe ikusasa lethu ezandleni zethu!" )
( govza_0198 "Lokhu kusho ukuthi mazingathi zisuka phansi amadaka, kube sekulindeleke ukuthi laba bafundi sekulindeleke ukuthi sebengenza izimanga zokukhuluma nokubhala ulimi lolo, kodwa kufanele bacathuliswe kancane ngokuthi banikwe ithuba lokulalela babuye bafunde umthamo othize olingene lelo zinga." )
( govza_0199 "Mema lowo osolwa ngecala ukuba akhokhe imali yokuvuma icala eyonqunywa yisikhulu kuSaziso seNhlawulo zingakapheli izinsuku ezingamashumi amathathu sikhishiwe, nokwethulwa kweSaziso seNhlawulo." )
( govza_0200 "Futhi imininingwane egcinwayo, ihlose ukuqinisekisa ukuthi izifiso zamakhasimende zivikelwe, futhi nongoti balandela isimo sekhasimende bese behlela nezinhlelo zomngenela, okufanele wenziwe esikhathini esizayo." )
( govza_0201 "Inqubo okumele uyilandele ukufaka isicelo sokuthola usizo lwezimali, noma olunye nje usizo kanye nezinye nje izindaba ezihambelana nokufaka lesi sicelo,  ezinye izindlela ezibalulekile ukuze kwenziwe lo mthetho usebenze kahle." )
( govza_0202 "Nokukwazi ukukhombisa ukuqondisisa ukuthi, umhlaba wakhiwe yinhlanganisela yezingxenye ezahlukene ngokuthi akwazi ukubona ukuthi, ingqikithi yokuxazulula izinkinga ayikwazi ukuzimela yodwana ithi qekelele." )
( govza_0203 "Uma iphoyisa likholelwa ngesizathu esibonakalayo ukuthi noma iyiphi impahla ezoseshwa, ingase ilinyazwe noma ilahlwe noma ichithwe uma ukungena kufunwa ngomlomo, futhi kubikwa isizathu sokufuna ukungena, ilungu lamaphoyisa lingayisebenzisa leyo ndluzula edingeka ngokunomqondo." )
( govza_0204 "Inhloso esemqoka yohlelo ukuqinisekisa ukuthi, uhulumeni usebenza ngokuhlanganyela nemiphakathi, kanye nabanye ababambi qhaza ukuqeda ubuphofu, bese wenza kangcono izinga lempilo ezindaweni ezisemaphandleni." )
( govza_0205 "Ukungqubuzana kwenqubo kungagwemeka ngokuba, inhlangano isungule futhi igcine imigomo yokuqondisa izigwegwe nokulalela izikhalo ngokucacisa imigudu yokuphatha, nencazelo elandisa ngezibophezelo zomuntu ngamunye." )
( govza_0206 "Lesi sigaba siyohamba ibanga elide ekwelulekeni ngalokho okufanele kucatshangwe ngumasipala ngamunye, lapho ehlongoza iqhinga leqhaza eliyobanjwa wumphakathi ngesikhathi samalungiselelo enqubo yentuthuko edidiyele." )
( govza_0207 "Isigaba-seshumi-nane soMthetho, silayela izinhlaka zomphakathi ukuba zihlanganise umqulu ozosiza ukuthola ukufinyelela ulwazi olugcinwe wuhlaka lomphakathi, futhi lumisela izidingo eziphansi okufanele umqulu lowo uhambisane nazo." )
( govza_0208 "Umfundi uzokwazi ukuthi, afunde ebe ebheka ulwazi nokuthi, athole ukuthokoza ngalokho akufundayo" )
( govza_0209 "nokuthi akwazi ukubhekana nezimo ezifana nokwazi ukuthi, yini okusemqoka okuthinta amasiko nemizwa kanye nalokho okuthandekayo okutholakale emibhalweni akufundile." )
( govza_0210 "Okudingekayo ukuthi zonke izizwe zomhlaba kufanele zikhombise lokhu kuzimisela uma kungukuthi, sizowenza umbono owemukelwa eminyakeni engamashumi eyadlula, ukuthi sibe ulwazi oluphilayo lwabo bonke abantu bomhlaba ngaphandle kokukhetheka." )
( govza_0211 "Amaqhinga nemisebenzi kamasipala kumele ahambisane nomgomo wenqubo yentuthuko yokonga imvelo isikhathi eside, nokuchaza ukuthi izinsiza zemvelo akufanele zinciphisele isizukulwane esizayo ithuba lokusebenzisa imvelo." )
( govza_0212 "Ukufunda lokhu, kubaluleke kakhulu kubafundi abasuke befunda ulimi abaluqala ngqa, ngoba lokhu abakufundayo okusuke kubhalwe phansi, yikona okuyisisusa solwazi abalusebenzisa kakhulu uma sebephumile ekilasini sebezikhulumela nje ngaphandle." )
( govza_0213 "Uma umkhiqizo wokuzalisa womuntu othile usetshenziswe ekumithiseni ngobuciko, umuntu wesifazane lapho lowo muntu evume khona ngokubhaliwe, ingane ezalwe yilowo muntu wesifazane ngenxa yobuciko kufanele ngokwayo yonke inhloso ithathwe njengengane yalowo muntu wesifazane." )
( govza_0214 "UNgqongqoshe angahoxisa ukuqokwa kwelunga njengosihlalo noma isekela likasihlalo, uma lokho kuzosiza umphakathi noma uma ilunga lingakwazi, noma lehluleka ukuqhuba umsebenzi walo njengosihlalo izinyanga ezingaphezulu kwezintathu." )
( govza_0215 "Inkantolo elalela isicelo ingakhipha imvume ngaphandle kombandela, noma ngaphansi kwemibandela ethile ebona ifanele, noma ichithe isicelo kodwa isicelo singavunywa kuphela uma lokho kuyosiza futhi kufeza izifiso ezinhle zengane." )
( govza_0216 "Umninimvume wesikhashana wokukhiqiza isisi emoyeni, unelungelo lemvume yokukhiqiza isisi uma isikhungo esigunyaziwe sihambisana ngokugcwele nezimo, nemibandela yemvume yesikhashana yokukhiqiza isisi emoyeni." )
( govza_0217 "Isivumelwano esibhaliwe singadinga noma sivumele isisebenzi sehlathi ukuba sisebenze amahora ayishumi nambili ngosuku, kuhlangene nezikhawu zekhefu lokudla ngaphandle kwenkokhelo yesikhathi esingeziwe." )
( govza_0218 "Uma usihlalo nesekela lakhe bengekho emhlanganweni, amalunga akhona emhlanganweni angakhetha elinye ilunga ukuba lengamele umhlangano, lenze wonke umsebenzi kasihlalo futhi lisebenzise amandla kasihlalo, kuze kube usihlalo noma isekela lakhe liqhuba umsebenzi walo." )
( govza_0219 "Izinkomba ezinkulu zikhomba ukuthi ososayense besifazane kanye nonjiniyela, abangeni emkhakheni wokufundisa, kanti nengqalasizinda esemqoka ibunjwe ngabantu abazothatha umhlalaphansi esikhathini esifushane kusukela manje." )
( govza_0220 "Inhlangano ezilawulayo noma umuntu odluliselwe amandla okuthatha izinqumo zokuqondisa izigwegwe, angaguqula noma abuyekeze isinqumo senhlawulo esikhishwe phambilini, kodwa ngeke ayenyuse inhlawulo idlule enqunye phambilini, lokhu uyokwenza uma kunesizathu esiqinile futhi elandela imigudu ebekiwe yokuguqula isinqumo." )
( govza_0221 "Intengo ingadluli emalini yangempela ekhokhwe ngokuthenga leyo mpahla yokugqoka," )
( govza_0222 "umqashi engafuna ukuba isisebenzi siyigqoke emsebenzini impahla yokusebenza" )
( govza_0223 "imvume yokuba isisebenzi sigqoke impahla noma singekho emsebenzini isisebenzi, sikhokhele umfaniswano noma impahla yokusebenza ngezikhawu ezine." )
( govza_0224 "Isivumelwane asiphazamisi umthetho wezwe okuvela kulo ingane elidinga ukuba ingane etholiwe evame ukuhlala kulelozwe, ihlale lapho noma ovimbela ukubekwa kwengane, noma ukwedluliswa kwayo ezweni eliyitholayo ngaphambi kokuyithatha." )
( govza_0225 "Wonke onegunya lokuhweba kufanele avule futhi agcine isikhwama ebhange elibekelwe amakhasimende" )
( govza_0226 "noma asebenzise isikhwama esivulwe salawulwa yisikhungo lapho kuyofakwa khona zonke izimali zekhasimende ezitholwe ngosuku" )
( govza_0227 "lokhu makwenziwe ngokuqonda ukuthi yonke imali efakwa yikhasimende esikhwameni somuntu ogunyaziwe" )
( govza_0228 "noma imali etholwe sekuvaliwe emabhange, kumele igcinwe kuleso sikhwama kuze kube wusuku olulandelayo lomsebenzi." )
( govza_0229 "Lapho imishini ekwazi ukuveza ingaphakathi lomuntu wesifazane okhulelwe iveza ukuthi, umama ukhulelwe umntwana oyisidalwa okukanye, kubonakala ukuthi impilo kamama okhulelwe isengozini yokushabalala ngenxa yosana alukhulelwe, lowo okhulelwe kumele asebenzise ilungelo lakhe lokuzikhethela." )
( govza_0230 "Lokhu kuchitha isikhathi samaphoyisa ngoba kudingeka izikhulu zithathe imoto noma, zindize ziye kuleyo ndawo okubikwa khona ubugebengu" )
( govza_0231 "lokhu futhi kuchitha izimali ngoba izikhulu zingathunyelwa ukuthi ziye endaweni lapho okungekho khona isimo esiphuthumayo." )
( govza_0232 "Uma umgcinisihlalo ngesizathu esithile engakwazi ukwenza imisebenzi yakhe, lawa amanye amalungu kumele akhethe omunye umuntu ngaphakathi kwabo ukuthi, aphathe njengomgcinisihlalo kuze kube yisikhathi lapho umgcinisihlalo akwazi ukuqalisa ukwenza imisebenzi yakhe noma omunye umgcinisihlalo amiswe nguNgqongqoshe." )
( govza_0233 "Laba bantu abalandelayo banelungelo lokwethula ubufakazi phambi kwenkantolo yeZingane, futhi uma bethola imvume yesiphathimandla esengamele inkantolo yeZingane, kanjalo ukuphonsa imibuzo ofakazi noma baphendule inkantolo ngesikhathi sempikiswano." )
( govza_0234 "Isitifiketi semfundo nokuqeqeshwa emfundweni ephoqelelwe, siyoba yisiqiniseko esipheleleyo sezikole futhi yisona esiyokwenza kufinyelelwe emiphumeleni ngokuthi, kusetshenziswe izindlela eziyizo zokuhlola ebangeni lesishiyagalolunye." )
( govza_0235 "Uzophefumula kalula angeke ube namazinyo anamabala noma neminwe enamabala, isikhumba sakho sizoba bushelelezi futhi sibe nempilo, uzoba nomoya ohlanzekile uzoba nezingane eziphile kangcono kunezabantu besifazane ababhemayo, angeke uchithe imali emkhubeni ongasile, uzokwenza ukuba izingane zakho zihlale ziphile kahle ngoba ungazenzi ukuba ziphefumule umoya omdala futhi onentuthu yogwayi." )
( govza_0236 "Induna noma ilungu lomndeni wasebukhosini lingaqokwa njengomuntu ozolalela amacala ezinkantolo zendabuko, ukuze lenze umsebenzi womholi wendabuko omdala uma yena engeke akwazi ukwenza umsebenzi wakhe." )
( govza_0237 "Noma yimuphi umuntu onika ubufakazi ngaphambi kwebhodi lokuphenya, angaphoqwa ukuba aphendule noma yimuphi umbuzo, noma akhiphe noma yimuphi umbhalo uma umongameli webhodi lokuhlola eyala kanjalo." )
( govza_0238 "Angifuni-ke nakancane ukuthi lesi sifo engizonitshela sona sithikameze uthando lwenu noma nisithathe njengesiqalekiso, ngoba namuhla izigidi ngezigidi zemindeni ziphethwe yiso lesi sifo." )
( govza_0239 "Inkantolo elalela isicelo esihlonzwe ngaphansi kwesigatshana sokuqala, ingakhipha imvume ngaphandle kombandela noma ngaphansi kwemibandela ethile ebona ifanele, noma ichithe isicelo kodwa isicelo singavunywa kuphela uma lokho kuyosiza futhi kufeza izifiso ezinhle zengane." )
( govza_0240 "Ungaphila kanjani ngesithunzi uma ungakwazi ukuya ndawo ngoba awukwazi ukuhamba, futhi akukho muntu okunika isihlalo sokuhamba." )
( govza_0241 "Ungazisiza kanjani uma kufanele uye esikoleni kodwa ungakwazi ukubona ukuthi kubhalweni encwadini" )
( govza_0242 "Ungaba kanjani ingxenye yempilo emphakathini uma ngabe wonke umuntu ehamba, wena bakushiye ngoba awukwazi ukujoyina kulokhu abakwenzayo?" )
( govza_0243 "Iqhinga lokusebenza lentuthuko yesifundazwe elinezinhloso zesikhathi esiphakathi, nezinkomba zokutshala imali nemisebenzi engaphakathi esifundazweni,, kuxuba uhlaka lwezimali lwesikhathi esiphakathi olubonisa izimali ezitshaliwe namaqophelo omsebenzi esifunda nemisebenzi esabalele nesifundazwe kanye nezinhlelo." )
( govza_0244 "Iholo lesonto lesisebenzi lapho inkokhelo ingabalwa khona ngokuthathela esikhathini, noma elithola iholo eliguqukayo, libalwa ngesilinganiso sesamba esididiyela amaholo amasonto ayishumi nantathu, uma uwehlukanisa izigamu eziyishumi nantathu." )
( govza_0245 "Lomthethonkambiso unika isikhulu esigunyaziwe amandla amaningi esingawasebenzisa uma sibheka ukuthi, umuntu noma umkhumbi uyayilandela yini lemithethonkambiso, nokuthi uma kusolakala ukuthi ayilandelwa kuphenywe lokho kwephulwa." )
( govza_0246 "Kufanele kuqashelwe ukuthi isikweletu noma ukusalela ngemuva ngenkokhelo, kungenzeka kusukele kumthengi wesikhathi sakudala, noma kube wumphumela wophenyo lokusetshenziswa kogesi ngemuva kwesikhathi esithile, nokuholela ekutholeni ukuthi umthengi wake waphazamisa ukuphakelwa kogesi ngenhloso yokuntshontsha umbani." )
( govza_0247 "Sinqume ingane igcinwe okwesikhashana esikhungweni sezingane nentsha, noma kwenye indawo noma kumuntu oqokwe yisiphathimandla esengamele inkantolo yezingane" )
( govza_0248 "igcinwe kuze kuphothulwe lonke uhlelo lwangaphansi kwalesi sigaba, nesinqumo esenziwe noma izinyathelo zalesi sigaba ziqala khona ukusebenza." )
( govza_0249 "Noma imuphi umuntu othintekayo odabeni, kungathi kulalelwe udaba enkantolo amelwe ngummeli noma ngummeli weNkantolo ephakeme, futhi angamelwa yinoma ngumuphi nje omunye umuntu amkhethile." )
( govza_0250 "Izilwane ezizala emotweni noma esibayeni, kufanele zihlaliswe zodwa namankonyane azo ngesikhathi kulindelwe isinqumo sikadokotela, esingabandakanya ukususwa kwenkonyane emadeleni, noma ukubulawa kwalo ngokulandela indlela emisiwe yokubulala, nokuqonda ukuthi izilwane ezizelwe akufanele zibulawe ngaphambi kwezinsuku ezintathu." )
( govza_0251 "I-Vuk'uzenzele kakhulu igxile ekukhiqizeni iphephabhuku likahulumeni lamahhala eligqamisa ezomnotho kanye namanye amathuba enziwe umbuso wethu wentando yeningi, nokuthi kufanele siwathole kanjani la mathuba." )
( govza_0252 "Uma ukukhandwa kwendiza, injini noma insimbi ethile noma umshini, kwenziwe ngemuva kokulimala okudalwe wukuhlala ngamawala kwendiza emhlabathini, noma ngempoqo noma umonakalo oyiphutha lasemkhiqizweni, umbhalo ofakwa encwadini yendiza mayelana nalokho kukhanda, kufanele kuchaze ukuthi sasikhona isidingo sokuba indiza ihlale ngamawala noma ngempoqo." )
( govza_0253 "Sikwazile ukunqoba lezi zinkinga kalula futhi nangesizotha, ngenxa yokuthi sinohulumeni wentando yeningi owakhelwe phezu koMthethosisekelo osebenza kahle, kanye nezikhungo zikahulumeni ezinohlonze." )
( govza_0254 "Zonke izinkampani nezimboni ezinkulu ezinikelayo, sezikhombise intshisekelo ekugqugquzeleni ubudlelwane phakathi kukahulumeni nomphakathi, okuyoba nomthelela wesimo lapho kuyothuthuka kusimame khona umnotho nezimpilo zabantu." )
( govza_0255 "Ngenxa yokuthi abantu balapha baludinga kakhulu usizo, yingaleso sizathu sithe yize kunesidingo nakwezinye izindawo, kodwa sithe akuqale unyaka omusha kuqale nesiqalo esisha ezimpilweni zabantu bakithi lapha kwaHlabisa." )
( govza_0256 "Ukudluliswa kwamacala ngenxa yezinqumo ezithathwe ezinkantolo ezingaphansi kwemithetho yamasiko, kumele kunqunywe yinkantolo yokudlulisela amacala ephethwe ngemithetho yamasiko, eyakhelwe ukulalela amacala adlulisiwe." )
( govza_0257 "Esigamekweni ngasinye sokuhlela, kwenziwa izincomo ngohlobo lwenhlangano nabantu okumele babambe iqhaza ngenhloso yokuqiniseka ukuthi, uhlelo lubandakanya wonke umuntu ofanele futhi kuboniswene." )
( govza_0258 "Lokhu kuchaza ukuthi, kufanele lucace ngezinto olufuna zenzeke noma ukwenqabela ukusetshenziswa komhlaba ezintweni ezithile, kodwa akusho ukuthi, seluyoshaya umthetho kuyo yonke indlela okumele kusetshenziswe ngayo isiqephu nesiqephu somhlaba." )
( govza_0259 "Siyalubonga uxhaso lwenu ngokuthi nenze lolu suku lube yimpumelelo, nokuthi nibuyise ithemba ezimpilweni zalaba bantwana, ikakhulukazi ngalesi sikhathi sonyaka, kusho uNdlunkulu uMantfombi." )
( govza_0260 "Umqondisi-Jikelele, noma inhloko yesifundazwe engamele intuthuko yezenhlalakahle, ingaqoka noma iyiphi inhlangano efanele ivikele ingane, lapho iyoqhuba khona ingxenye noma wonke umsebenzi oqondene nokuvikela esifundazweni esifanele." )
( govza_0261 "Nikeza isaziso kumnini noma omunye umuntu okunguyena onomthwalo wokugcina" )
( govza_0262 "noma ukulondoloza noma imuphi umkhumbi ongaphakathi kwemingcele yechweba,sinxuse lowo muntu ukuba asuse noma alahle lowo mkhumbi" )
( govza_0263 "noma yini enye into eyingxenye yalowo mkhumbi engakulungele ukuba solwandle ngokubona kweSigungu seziPhathimmandla" )
( govza_0264 "noma okungenzeka ibe yisivimbelo noma imvithi noma ibe into elahliwe noma ibe yingozi emvelweni noma ekuphepheni komphakathi." )
( govza_0265 "Umuntu owephula lokho okushiwo kulesi sigaba uyakubekwa icala, kanti uma elahlwa yicala, uyokhokhiswa inhlawulo noma ukuphonswa ejele isikhathi esingeqile eminyakeni emibili noma kokubili inhlawulo nokubhadla ejele." )
( govza_0266 "Akungavunyelwa muntu ukuqhubeke nomsebenzi ngaphambi kokuthatha zonke izinyathelo zokuphepha ezifanele akuthathwe izinyathelo zokuqinisekisa ukuthi wonke umuntu ongaphansi komqashi ulandela uMthetho akuphoqelelwe indlela efanele yokugwema izingozi ngentshisekelo yokulandela umgomo wokuphepha nempilo enhle." )
( govza_0267 "Ukugcizelela kwethu ukuba kwandiswe ukwelekelelwa kwezindlela zezempilo, ezihlanganisiwe njengeqola ezoletha nezindlela ezintsha zokuqeqesha nokugcinwa kwabafundele ezempilo, nomthelela endleleni okwenziwa ngayo eAfrika nasemhlabeni wonke." )
( govza_0268 "Ikomidi lokuhlunga liyokwakhiwa ngamalunga okungenani amathathu nokuyizisebenzi ezisezingeni elilinganayo, noma eliphakeme kunezinga lesikhundla esizogcwaliswa noma kube ngabantu abakulungele abavela ngaphandle kwenkonzo yezisebenzi zikahulumeni, noma lapho bemelelwe khona bobabili isisebenzi noma izisebenzi kanye nalowo muntu noma abantu." )
( govza_0269 "Sizosebenza ngezimo ezifanele zale mithetho, ngenhloso yokuzama nokukunika umqondo wenqubo ethintekayo ekuthuthukiseni amaqhinga okwakha izinhlelo emsebenzini, nokuthi umqashi engahlomula kanjani ngokubamba iqhaza." )
( govza_0270 "Inkantolo iyokhipha umyalelo wokuthi ummangali avikeleke kuwe uma ungavelanga enkantolo ngalolu suku kanye nangalesi sikhathi, njengaloku kushiwo lapha ngenhla, futhi uma inkantolo yeneliswa ukuthi lesi saziso, safinyelela kuwe ngendlela efanele futhi yeneliswa ukuthi, wena wasenza noma uyaqhubeka nokuthi wenze isenzo sodlame lomndeni." )
( govza_0271 "Izindlela namaqhinga asetshenziswe ngamathimba obugebengu obuhleliwe," )
( govza_0272 "ngenhloso yokuhweba ngabantu kuhlangene nokuqasha nokuhambisa abantu abahlukunyeziwe," )
( govza_0273 "izindlela ezisetshenzisiwe nokuxhumana phakathi kwabantu ngabanye, namaqembu enze lomsebenzi wenkohlakalo yokuhweba ngabanye nokwenza imizamo yokuthola amaqhinga abawasebenzisayo." )
( govza_0274 "Isiphathimandla sikazwelonke siyolawula futhi sigcine noma iyiphi inyama esolwa ngokuthi, ayinayo imvume yokudliwa ngabantu noma yizilwane noma umkhiqizo wesilwane okunezinsolo eziqinile zokuthi ayiphasiswanga." )
( govza_0275 "Izehlakalo zamanje zangempela zezwe zidinga ukuthi, uhulumeni abuyekeze indlela anikezela ngayo imithombo yakhe, ukuqinisekisa ukuthi kunikezelwa ngokulinganayo kulabo ababandlululwa esikhathi esedlule." )
( govza_0276 "Uma amalungu omphakathi amabili ekholwa ukuthi anelungelo lokuvumela imfuyo yawo ukuthi, idle endaweni eyodwa, umHoli weNdabuko uyabizwa ukuthi azochaza ukuthi ngubani phakathi kwabo onelungelo lokusebenzisa leyo ndawo." )
( govza_0277 "Ngokwenabile, inkululeko yomuntu ikhomba ilungelo lomuntu lokuthi avikeleke ezenzweni ezingubudedengu zombuso, okungathi ngesinye isikhathi zihlukumeze noma zilulaze isithunzi somuntu ngokwengqondo noma ngokomzimba." )
( govza_0278 "Ukuqaphela ukuthi umsebenzi nomshini usetshenziswa ngumuntu ngaphansi kweso lalowo oqeqeshelwe lomsebenzi, noma umshini ukuze aqonde kahle ngobungozi obuphathelene nomsebenzi noma lowomshini." )
( govza_0279 "Akukuhle ukuba umshayeli ashayele esandleni sokudla ngendlela eholela abanye abashayeli bedlule esandleni sokunxele ngenxa yokuthi, yena ubambelele ekutheni uhamba ngejubane elisemthethweni." )
( govza_0280 "Le mpikiswano ibunjwe yimibono noma yiziphakamiso eziqonde ukugcizelela isimo somthetho, noma amaqiniso esimo futhi isetshenziselwa ukujika umqondo wenkantolo ngesikhathi ikhipha isinqumo." )
( govza_0281 "Noma yimuphi umbhalo ogcinwe ngenhloso yokuqoqa umbiko ofakwa ezincwadini zendiza, noma umbiko othinta uhlelo lokubhala ngaphandle nje kwencwadi yendiza uqobo, uyovezwa uma kwenzeka ufunelwa ukuhlolwa noma uphenyo yisiphathimandla esigunyaziwe, ngumhloli noma ngumuntu onegunya." )
( govza_0282 "Sibonise ukunaka simqondisise omunye umuntu sibonise ukukhathalela kanye nokuqonda, sikhiphe inkinga uma ngabe ikhona, silalele ukuthola izimbangela zenkinga sisize okhulumayo ukuthi, ahambise inkinga nembangela ukugqugquzela okhulumayo ukuthi athuthukise ukwazi ukwenza kanye nokumgqugquzela ukuxazulula izinkinga zakhe, sifunde ukuthula uma ukuthula kudingeka." )
( govza_0283 "E-Afrikha, nakuba ungacacile kahle umehluko phakathi kokwakhiwa kwemithetho nokusetshenziswa kwayo, kodwa akukho muntu oke akhononde ngendlela abaholi bendabuko abasebenzisa ngayo amandla abanawo ekushayweni kwemithetho." )
( govza_0284 "Uhlelo lwethu lokunakekela abasebenzi kanye nalolo olukhuthaza abantu ukuba bazigcine bephilile, zizoqiniswa nonyaka ukuze sigqugquzele ukuziphatha ngendlela enempilo nokushintsha izinto ezikhubaza impilo." )
( govza_0285 "UMqondisi-Jikelele angakhipha imiyalo yokuvikela kuphela uma kunesizathu esenza akholwe ukuthi, kuzokuba nokugxambukela okungekho emthethweni kwezokuthutha zasolwandle okungenzeka noma okuhlongozwayo nokuthi kuthathwe isinyathelo esithile, ukuze kuvinjelwe lokho kugxambukela okungekho emthethweni kwezokuthutha zasolwandle kungenzeki." )
( govza_0286 "Umphakeli kumele athathe inani lezigamu zombani ngaphambi kokuqala umsebenzi wokuhlola bese eqikelela ukuthi, umthengi uyabuyiselwa lezo zigamu ekade zikhona esigujini ngaphambi komsebenzi." )
( govza_0287 "Izingane ezincane kakhulu kufanele ziphathwe ngendlela ehlukile ezinganeni ezindala, futhi izingane ezephula umthetho okokuqala kufanele zinikwe ithuba lokubuyisela izimpilo zazo esimeni esilungile." )
( govza_0288 "Uma umnikazi wendlu engekho umasipalati, angasibuyisa ngokuphelele isamba semali yentela yendawo okufanele sikhokhelwe indlu noma, asibuyise ngezikhawu kulowo muntu owamukela imali yenkokhelo yendlu egameni lomnikazi." )
( govza_0289 "U-MEC angayisusa imoto engasebenzi noma umshini noma ingxenye yawo engasebenzi noma udoti otholwe emgwaqweni wesifundazwe, noma kulayini wajantshi, bese efuna izindleko zaloku kumuntu olahle noma oshiye loku emgwaqweni noma kulayini wajantshi." )
( govza_0290 "Ehlinzekelwe imindeni enezingane ngenhloso yokuqinisa nokwakha amandla angaphakathi, nokuzimela ngenjongo yokuxazulula izinkinga ezingavela noma eziyovela emndenini okungathi lapho zingalungiswa, ziholele emngeneleni womthetho." )
( govza_0291 "Onke amaphepha ahambisana nanoma yimuphi umhlangano womkhandlu noma ikomidi, kumele anikezelwe kuwo wonke amakhansela okungenani kusasele izinsuku ezinhlanu zekhalenda ngaphambi komhlangano womkhandlu noma, ikomidi ojwayelekile nezinsuku ezimbili zekhalenda emhlanganweni ophuthumayo womkhandlu noma emhlanganweni ophuthumayo wekomidi." )
( govza_0292 "Lemisebenzi isiza abethula imisebenzi emazingeni onke ukusingatha kangcono izinhlelo nemisebenzi, ngokwethula ngesikhathi imibiko nokunika isiqiniseko sokuthi ngabe izinhlelo ziyahambisana yini nezidingo zamakhasimende." )
( govza_0293 "Imihlangano yeziko ibanjwa ngezikhathi nendawo enqunywe ngusihlalo, kodwa amalunga amane eziko analo igunya lokuphoqa usihlalo ukuba, abize umhlangano weziko zingakapheli izinsuku eziyisikhombisa zamalanga okusebenza." )
( govza_0294 "Ukufunda ulimi olwengeziwe lwesibili, lokhu kufanele kubasize abafundi ngokuthi bazitholele amasu athile okufunda ulimi, ngoba phela ukufunda izilimi ezintsha lezi uzifunda impilo yakho yonke." )
( govza_0295 "Lowo othula izidingo nekhasimende, kufanele ngokuhlanganyela banqume indlela yamanje esisebenza ngayo isimo senhlalo, bese bebumba iqhinga lomngenela oyosiza ikhasimende lifinyelele ezingeni eliphezulu lenhlalo, futhi lilungele ukwemukelwa kabusha wumphakathi." )
( govza_0296 "Uma ngasizathu thize usihlalo engakwazi ukwenza umsebenzi wakhe, amanye amalungu kumele akhethe omunye umuntu phakathi kwawo ahlale endaweni kasihlalo kuze kube usihlalo, uyakwazi ukuphinde enze umsebenzi wakhe noma kuze kube uNgqongqoshe ukhetha omunye usihlalo." )
( govza_0297 "Ngemuva kwalokho, wonke umuntu uyothola ithuba lokufaka isicelo sokuthi ahlolelwe isikhala sakhe somsebenzi, lapho ebona sengathi umkhakha wakhe awubonisi kahle ingqikithi yomsebenzi wakhe noma uma ebona sengathi umsebenzi wakhe ushintshile ngemuva kokuhlolwa kokuqala kwemisebenzi." )
( govza_0298 "Noma yikuphi ukushayisana noma ukungavumelani ngokuthi kumele kube yisiphi isiphathimandla esifanele ukuhambisana nanoma yisiphi isicelo esithile, kumele kuxazululwe nguNgqongqoshe kanye nomphathi womnyango kahulumeni wesifunda waleso sifunda, noma nguNgqongqoshe kanye nelungu likahulumeni elinikezelwe ukubhekana nalokho, okuyikhona okufanele." )
( govza_0299 "Noma iliphi ilunga loMkhandlu elifisa ukushiya isikhundla sobulunga, kufanele lilethe isaziso sokushiywa kwalo sibhaliwe sibhekiswe kuMongameli, kanti uMkhandlu kufanele usamukele isaziso uma ngabe zonke izimali zobulunga okufanele lizikhokhe zikhokhiwe." )
( govza_0300 "Incwadi ebiza ufakazi ukuba avele phambi koMkhandlu noma phambi kwekomiti lokuziphatha emsebenzini njengofakazi noma ukuletha incwadi, irekhodi noma umbhalo noma yintoni, kufanele kwenziwe ngefomu elinqunyiwe futhi kufanele ithunyelwe ngeposi ibhaliswe noma ngendlela efanayo nencwadi ebiza umuntu ukuba avele phambi kwenkantolo kamantshi." )
( govza_0301 "Ungqongqoshe angasusa usihlalo ehhovisi lokuphatha noma aqede ubulunga banoma yiliphi ilunga uma kunesizathu esihle salokho, lesi sinyathelo siyothathwa ngemuva kokunika usihlalo noma elinye ilunga ithuba elenele lokuveza ubufakazi noma ukuzivikela ukuthi kungani singafanele isinyathelo sokususa noma sokumisa ubulunga." )
( govza_0302 "Izinhlelo zokufunda kumele ziqiniseke ukuthi yonke imiphumela yokufunda kanye nezindlela zokuhlola, kuqhutshwa ngemfanelo nanokuthi yilowo nalowo mkhakha wezefundo unikezwa isikhathi kanye nalokho okufanele kugcizelelwe kuwo." )
( govza_0303 "Ukugxeka okuchazwe ngenhla kusebenza nasenkambisweni yenqubo yokuthuthukisa umphakathi nokuphawula umehluko emiphakathini ethile ekhombisa intuthuko eyayigxile kakhulu ekuthuthukiseni abantu nokubanika amandla okuzenzela." )
( govza_0304 "Umkhakha wesithathu kumele ubalelwe phezu kwenani langempela okumele likhokhelwe intela,ngoba inhloso yalo mkhakha ukusiza ukukhokhela umehluko phakathi kwentela yabasebenzi, kanye nentela yesikhashana esikhokhiwe kunyaka kanye nemali ephelele yentela okumele ikhokhelwe kulowo nyaka wentela." )
( govza_0305 "Njengamanje uhlaka lokuveza isimo abasebenzi abenza ngayo imali, luyabuyekezwa ukuze lubophezele bonke abasebenzi bakahulumeni ukuveza umumo wabo wezezimali ngale kwezikhundla zabo noma izibopho zabo." )
( govza_0306 "Noma imuphi umuntu ongekho ngaphansi kwemithetho elawula, abasebenzi bombuso kuyofanele aholelwe iholo kumbandakanya nezimfanelo zokuhamba nokudla, angene kuzo uma esebenzisa amandla,noma enza umsebenzi noma efeza izibopho abelwe zona noma azithweswe nguMqondisi-Jikelele, ezimiswe uNgqongqoshe ngokubonisana neNgqongqoshe weziMali." )
( govza_0307 "Ngokuhambisana nokushiwo yilesi sigaba, othumele isaziso esibhaliwe noma incwadi yokushiya kwakhe isikhundla, wayithumela kuMongameli futhi noMkhandlu wamukela lokho kushiywa kwesikhundla uma zonke izimali zobulunga zikhokhiwe." )
( govza_0308 "UMkhandlu obhekela amaKhono usuveze isidingo sokuba, kubhekisiswe kukhethwe izinhlelo zomphakathi ezidinga ukuxhaswa ukuze ukuthuthukiswa kwamakhono kube yiyona nto ehamba phambili kulezo nhlelo." )
( govza_0309 "Ukuhlola nokuqapha noma imuphi uMthetho wePhalamende noma imuphi omunye umthetho noma isivumelwano, ukuphenya izikhalo ngokuzisukumela noma ngemuva kokuthola isikhalo futhi bese uzama ukuxazulula noma iyiphi inkinga noma ukulungisa isenzo noma ukwehluleka ukwenza okuthile." )
( govza_0310 "Imvama yamabhizinisi amakhulu anamandla okuthungatha ubuchwepheshe emhlabeni, kodwa amancane ahlangabezana nobunzima futhi kungenzeka amabhizinisi abantu abamnyama abe namathuba amancane okuzakhela amaxhama okuxhumana maqondana nokuthungatha ubuchwepheshe." )
( govza_0311 "Mayelana nezinhloso zokuhlola okudidiyele umasipalati, kufanele ahlele isikhathi esingeke sibe ngaphezulu kwezinyanga eziyisishiyagalolunye ngaphambi kokuqala konyaka wezimali, lapho kuzoqala khona ukusetshenziswa kwamaphepha okuhlola." )
( govza_0312 "Awukho umshado ongekho emthethweni ongachithwa, kuze kufike isikhathi lapho inkantolo efanele yenze uphenyo nokucubungula indlela yokuphephisa amalungelo nezifiso zengane etholwe kulowo mshado." )
( govza_0313 "Amaphilisi okuhambisa isisu kanye nembiza yokuchatha, kubangela ukuba umzimba wakho ulahlekelwe izakhi eziningi ezibalulekile futhi, kumane kuyikhambi lesikhashana elingayixazululi inkinga yangempela." )
( govza_0314 "Sizokwenza imizamo enamandla ngokusemandleni ethu onke esinawo ukwenza ukuthi, leli phupho lethu lifezeke ngokuthi sibhekane nazo zonke izindaba ezithinta ukufunda nokufundisa lapha ezweni lakithi." )
( govza_0315 "Izinkulumo-mpikiswano zokuhlala kwePhalamende zingenye indlela yokuletha ulwazi olubalulekile ngaphambi kukahulumeni, ukuze alubhekisise mayelana nezinhlelo ezithile zikahulumeni noma imithetho edingekayo ukuze kuthuthukiswe ukulethwa kwezidingo kubantu." )
( govza_0316 "IKomiti eliphethe kufanele lihlangane ngezikhathi nasezindaweni eziyonqunywa ngusihlalo walelo komiti, futhi isibalo sabantu abanele abangathatha izinqumo kuyakuba iningi lamalunga ekomiti eliphethe." )
( govza_0317 "Inqubo yokuphatha izigodi zemvula, kumele isho ukuthi imithombo yamanzi izophathwa kanjani ngaphakathi kwezindawo zokuphatha amanzi nokuthi, umphakathi ungabamba iqhaza kanjani ekuphatheni imithombo yamanzi." )
( govza_0318 "Lokhu kukhombisa ukuthi, umyalo wokuphoqa kuhloswe ngawo ukuba kulungisiswe izinkinga ezithile futhi, kufanele kuqashelwe ukuze kuqinisekiswe ukuthi izenzo noma imisebenzi ebalwe kuwo umyalo iyaqhubeka nokubhekana nokwephula." )
( govza_0319 "Inani eliphelele lentela kunyaka ogcwele, ususe intela ekhokhelwa abasebenzi ekhokhelwe unyaka ogcwele ususe, umkhawulo ovunyelwe wezimali zentela yangaphandle yonyaka ogcwele, kususwe inani elikhokhiwe lesikhathi sokuqala sonyaka." )
( govza_0320 "Seziphinde futhi zengezelwa umthwalo wokuba, zabe izimali zikaHulumeni kwezobuciko, ukudayisa izwe emazweni omhlaba kanye nokudala ukutholakala kwamathuba kwezobuciko kwayo yonke imiphakathi yaseNingizimu Afrika." )
( govza_0321 "Umkhandlu wezimvume, kufanele ubuyekeze imvume yesikhashana yokukhiqiza isisi emkhathini noma lemvume ibuyekezwe ngezikhathi ezithile ezimiswe kuyo noma lapho izimo zikhomba isidingo sokubuyekezwa." )
( govza_0322 "La mahhovisi ezifunda aphinde ahlukaniswa futhi aba amahhovisi angaphansi kwezifunda kanye namahhovisi ezigodi lapho umphakathi ungathola khona izindaba zokuhambela kwamanye amazwe kanye nezemisebenzi kaHulumeni ye-DHA." )
( govza_0323 "Uhulumeni noma Unobhala, ngeke athwale isibopho sokuhlawula umonakalo noma ukulahlekelwa okusukela osizweni olwethulwe ngaphandle kwenhloso yobubi yilowo Nobhala, ngesikhathi esiza lelo qembu kweNkantolo noma ekuqhubeni umsebenzi wokuhlangabezana nesinqumo ngokulandisa kwale mithetho ngesikhathi eluleka ngokomthetho noma ehlanganisa, eqoqa imibhalo yanoma yiluphi uhlobo lwenqubo noma umqulu." )
( govza_0324 "Umehluleli uveza ukuthi, kungaba yinto ethandekayo ukuba izinkantolo zisungule imithetho emisha yomthetho wendabuko ukuze, uveza umthetho obusayo wendabuko nokusondeza imithetho yendabuko eduze komthethosisekelo wezwe, njengamanje ikhambi alibonakali kulolu daba ngenxa yokuthi, umthetho wokwaba ifa ngokomthetho wendabuko weseka kakhulu uzalo lowesilisa kanti yisimo esihlaziywa ngasinye." )
( govza_0325 "Inhloso yalo mkhakha, ukusiza abakhokhi bentela ukuthi bakhokhe umehluko phakathi kwentela yabasebenzi kanye nentela yesikhashana esivele ikhokhiwe yonyaka, kanye nenani lilonke lentela okumele ikhokhwe kunyaka wokuhlola imali okumele ikhokhwe." )
( govza_0326 "Umlawuli-sikhungo noma umuntu oqokwe esikhundleni sakhe, angahambela noma yimiphi imihlangano yesigungu esilawula inhlangano ezilawulayo, noma ikomidi lokulawula, futhi angabamba iqhaza kuyo yonke into eqhubekayo kulowo mhlangano ngaphandle kwelungelo lokuvota." )
( govza_0327 "Sibuye sibhekele ukuchithwa kwemithetho ethize futhi siqukethe namalungiselelo esikhashana azokusiza ukuba, kube lula ukudlulela esigabeni esiphakathi komthetho osasebenzayo kanye noMthetho ongeniswayo." )
( govza_0328 "Amakhabethe okugezela, afuneka emadeleni akhiqiza kancane nawomkhiqizo omkhulu kufanele afakwe eduze nezindawo zokusebenzela, ukuze akwazi ukuvikela amanzi achitheka ngesikhathi abasebenzi begeza amaphinifa abasebenza ngawo esemzimbeni yabo, futhi lamakhabethe kufanele avumele ukugobhoza kwamanzi okungena ngqo emgudwini noma emseleni ofanele wamanzi angcolile." )
( govza_0329 "Uma abafuna ukushadana bevela phambi kwesiphathimandla sokushadisa ngaphambi komshado ngenhloso yokubopha ifindo lomshado wobuSulumani, bese nesiphathimandla siba nezinsolo zokuthi omunye wabo uneminyaka emvimbayo ekungeneni emshadweni wobuSulumani ngaphandle kwemvume yomunye umuntu, isiphathimandla sokushadisa singenqaba ukubhalisa lowo mshado ngaphandle uma sinikwa leyo mvume noma, igunya elibhaliwe noma ubufakazi obenelisayo bokuthi, lowo othintekayo unelungelo lokushada ngaphandle kwemvume noma kwegunya lothile." )
( govza_0330 "Imihlangano yengosi ibanjwa ngezikhathi nendawo enqunywe ngusihlalo, kodwa amalunga amanye analo igunya lokuphoqa usihlalo ukuba, abize umhlangano wengosi zingakapheli izinsuku eziyisikhombisa zamalanga okusebenza." )
( govza_0331 "Kubaluleke kakhulu ukuthi umhlaba usebenze ndawonye ukusiza wonke umuntu ukuthi afunde, futhi afunde ngezinto ezibalulekile njengesayensi nobuchwepheshe kanye nezindlela zesimanje zokufundisa." )
( govza_0332 "Izwe ngalinye liyocabanga ngokuthatha izinyathelo ezigunyaza ukwenqaba isicelo sencwadi yokungena ezweni, noma ukuchitha imvume ekhona yokungena ezweni kubantu abathintekayo ebugebengwini obuchazwe kuleNqubo." )
( govza_0333 "uNgqongqoshe kufanele acubungule lolo daba ngokulandela inqubo emisiwe, kanti angakhipha isinqumo kuphela ngemuva kokuba esevumele futhi wanika ithuba bonke abathintekayo ukuba benze iziphakamiso." )
( govza_0334 "Induna yomkhumbi kufanele kuthi ngazo zonke izikhathi ilawule umkhumbi,ngesikhathi umkhumbi unyakaziswa kanti ngeke induna noma imuphi omunye umuntu ongaphansi kwenduna ongaphazamisa ukuhamba komkhumbi emanzini, noma ukunyakaziswa komkhumbi noma avimbela umkhaphi ekwenzeni umsebenzi wakhe ngaphandle uma kunesimo esiphuthumayo noma ebucayi, lapho induna ingathikameza ukuze iphephise umkhumbi, imithwalo kanye nabasebenzi bomkhumbi ngendlela angabona ifanele ukuze avikele ingozi." )
( govza_0335 "Imvume yokuthumela impahla ngaphandle idingeka ukuqinisekisa ukuthi, umuntu siqu noma inhlangano enenhloso yokuthumela izimpahla ngaphandle, ilandela imibandela ethize ebekiwe kanye nokulandela imibandela yezivumelwano zamazwe omhlaba." )
( govza_0336 "Kuyiqiniso futhi ukuthi, umnyango usebenzisana neminye iminyango nemikhakha ezintweni ezithile ngenhloso yokuqinisekisa ukuthi, imiphakathi ithola usizo nomthamo omkhulu womhlomulo ngemisebenzi ethulwayo." )
( govza_0337 "Ukuhlola njalo uhlelo oluqhubekayo ngenhloso yokuthola ukuthi, lusaqhubeka ngendlela ehlosiwe nokuhlola umthelela walo, yimizamo esiza ukukala inzuzo nokwenza ngcono imisebenzi yokuqhubeka kohlelo." )
( govza_0338 "Iyavuseleleka ngaphansi kwesimo sokuthi wenze isicelo sokuvuselela ilayisense kungafiki izinyanga eziyisithupha, futhi kungakadluli izinyanga ezintathu ngaphambi kosuku lokuphela kwesikhathi selayisense ekhona." )
( govza_0339 "Isivumelwane singavuma ukuba, umqashi anike umuntu osebenza ngeSonto ikhefu lokuphumula elikhokhelwayo elilingana nomehluko wenani, phakathi kwenkokhelo etholwa yisisebenzi ngokusebenza ngeSonto kanye nenkokhelo egunyaze ukutholwa yileso sisebenzi." )
( govza_0340 "Ungqongqoshe wesiFundazwe ongamele intuthuko yezenhlalakahle, akakwazi ukwedlulisa ingane esikhungweni sokunakekela ingane nentsha esizinze kwesinye isifundazwe, ngaphandle kwemvume kaNgqongqoshe wesiFundazwe ongamele intuthuko yezenhlalakahle kuleso sifundazwe nangaphandle kwamalungiselelo amisiwe ezimali mayelana nokwedlulisa okwenziwayo." )
( govza_0341 "Isinqumo sohlelo lwempahla yomshado esisebenza kulowo mshado noma imishado ngeke sisasebenza" )
( govza_0342 "futhi sigunyaze amathimba athintekayo ukusayina isivumelwane esibhaliwe" )
( govza_0343 "lapho uhlelo oluzayo lwempahla yomshado luyolawulwa khona ngaphansi kwezimo ezinqunywe yinkantolo." )
( govza_0344 "Wanikezwa omunye wokuba awugcobe emashiyeni." )
( govza_0345 "Uthe uma ethi qhamu ambone uQoveqove emi ephulula isilevu." )
( govza_0346 "Wayethi nje chokochoko bese eyeka." )
( govza_0347 "Ehhovisi lika Dokotela kwathathwa amaningi amabhodlela emithi, kanye nezipopolo nemijovo." )
( govza_0348 "Umzimba wami wawudikiza sengathi ngingenwe imfiva." )
( govza_0349 "Isichazamazwi salolu limi ngesika Brusciotto esaphuma ngo-." )
( govza_0350 "Yingakho ke izifundo zohlelo zibunjwe zaxutshaniswa nokusetshenziswa kolimi oluphilayo." )
( govza_0351 "Othisha mabazame izibonelo baphinde bakhuthaze abantwana, ukuthola inkulumo ecacile eqondile engenakudiyazela." )
( govza_0352 "Khetha amaphuzu asemqoka ushiye imininingwane." )
( govza_0353 "Useshonile uGwebu impilo kaDelsie seyonakala ngokwedlulele." )
( govza_0354 "Sekuvela uNosimilo Dhlomo intombazane eziphethe kahle esontayo." )
( govza_0355 "UDick ungumseshi emini ebusuku ungumholi weqembu lezigebengu." )
( govza_0356 "Incwadi ibhalwe yaba ingxoxo okusho ukuthi yindaba exoxwayo." )
( govza_0357 "Ngenxa yemfuyo isizwe samaMasayi siphila impilo yonozulazulane, omanxiwa kamili mbuya." )
( govza_0358 "Uzimelele ngobhoko unyawo ulubeke phezu kwedolo lomunye umlenze." )
( govza_0359 "Kwahamba kwahamba yancipha imfuyo zaphela izinkomo nezimbuzi." )
( govza_0360 "Kwaba sengathi uphaphama ebuthongweni uTajewo, uphaphanyiswa ngamazwi alesi sihambi." )
( govza_0361 "Ake uphume neqhinga phela Tajewo." )
( govza_0362 "Pho sebewumthuqasi izintuli zihlangene nomjuluko." )
( govza_0363 "Meromo mngane wami asiziyeke lezo." )
( govza_0364 "UTajewo usalokhu eculile futhi izwi lakhe, selishiso okwelomzwilili." )
( govza_0365 "Bahleka oTajewo noMeroro, lapho bebona ubuphukuphuku babo bokukhohlwa imvelo." )
( govza_0366 "Nsizwa asizame ukubhukuda; sigwedle siyophuma ngale kwalo mfula." )
( govza_0367 "Futhi ngifuna isipho esingavamile, esingajwayelekile, hhayi imfucumfucu nje." )
( govza_0368 "Phela lo mlomo wenyoni ucije okomcibisholo." )
( govza_0369 "Kuthule nje abakade befakwa nyanga zonke iminyaka ngeminyaka." )
( govza_0370 "Nakhu nalapho kubhalwe khona ngo-inki obomvu, ubuxakaxaka bezinombolo." )
( govza_0371 "Isibhala iyasheshisa le ntombazane manje." )
( govza_0372 "Abantu abakhohlwa engumuntu onozwela, ngoba ehawukele umfelokazi." )
( govza_0373 "Ayenze ibe ngamarandi amahlanu nerandi elilodwa." )
( govza_0374 "Inkosikazi ifake imali esikhwameni ilungise isikhwama iphume ihambe." )
( govza_0375 "Abahambi bezindawo babika ukuthi bake bambone eshayela phezulu emgaqweni." )
( govza_0376 "Abanye bathi bake bambone esebenza ethengisa emakhekheni." )
( govza_0377 "Awu loya wansondo, usengagoqana namakhekhe nje kuphela." )
( govza_0378 "Babhekane nalabo abasha asebesebenza eposini." )
( govza_0379 "Khona lapha kulendawo kwathiwa iphume nobovu ngempela." )
( govza_0380 "Kwavele kwafika nje insizwa elunge kanjani." )
( govza_0381 "Abantu bezwa nje ukuthi baphathiswe okwabantu." )
( govza_0382 "Kwaphela lokhu ukuba umuntu alindele ukuthenga isitembu, aze agugele khona eposini." )
( govza_0383 "Nezingane azabe zisashaywa emakhaya ngoba zibuye noshintshi ongalungile." )
( govza_0384 "Yingakho ke sekuhleli eduze kwakhe inkosikazi iphethe amaphepha nepeni." )
( govza_0385 "Kuthi uma eseqalile ukukhuluma kuze kube sengathi useba ngcono." )
( govza_0386 "Ibhale inkosikazi isheshile ingafuni ukushiya nelilodwa igama." )
( govza_0387 "Naye akhulume kuze kube sengathi lona obhalayo ubhala ngomshini." )
( govza_0388 "Kodwa ngubani ongabe esamkhuza ngaleso sikhathi." )
( govza_0389 "Kakusaziwa noma uzothi eyiqeda lencwadi ukuyibizela abe eseshona. Ngisizeni muzi waseZitendeni." )
( govza_0390 "Uma lencwadi ifinyelele kuThishomkhulu, uyokwazi ukungithungathela abaqondene nayo, basheshe bayithole." )
( govza_0391 "Njengoba ngibhala nje ngiphansi kwethunzi lokufa." )
( govza_0392 "Ngingathi ngiyiqeda le ncwadi ngibe ngiphela." )
( govza_0393 "Sekudala kufuneka ngiyibhale kodwa ngeswela ongangibhalela yona." )
( govza_0394 "Igama layo laliqala ngo, kangisalikhumbuli lonke." )
( govza_0395 "Kuthiwa uma ngingakaxolisi kuyo ngeke ngikuthole ukuphumula." )
( govza_0396 "Nakini nonke ngiyaxolisa ngendlela enganginiphatha ngayo." )
( govza_0397 "Kodwa okwenkosikazi yakwaMncube kwedlulela." )
( govza_0398 "Uthi izingane zakhe zadla udaka ngenxa yami." )
( govza_0399 "Uthi umkakhe wahamba ezula ezintabeni njengomhlanga ebamba eyeka." )
( govza_0400 "Ungichazela ukuthi izingane zakhe ngabe zafunda." )
( govza_0401 "Kunamuhla zicosha amazambane emapulazini zigqoma imigwaqo." )
( govza_0402 "Kunye okuthiwa kufuneka ngikuthole uxolo lukaMaMncube noma lwezingane zakhe." )
( govza_0403 "Ngicela nihlanganise imali nikhweze uMaMncube noma omunye wezingane zakhe." )
( govza_0404 "Yimina ozithobayo nocela uxolo uNkosazana." )
( govza_0405 "UThishomkhulu uPhakathwayo ameme umhlangano." )
( govza_0406 "Ahle awukhombe ngakusasa khona esikoleni." )
( govza_0407 "Kuvele kumenyezelwe ezinganeni ukuthi kunodaba oluphuthuma kabi, okufanele luzodingidwa esikoleni." )
( govza_0408 "Bathi lomhlangano ubanike ithuba elincane lokuba bazi ngawo, ngoba bona bayasebenza." )
( govza_0409 "Cha, uThishomkhulu uyifunda kahle ngesineke impela." )
( govza_0410 "Kusize khona ukuthi kukhona nabefundisi khona lapha." )
( govza_0411 "Kwayena uThishomkhulu ungumfundisi futhi." )
( govza_0412 "Kube ngumzukuzuku ukuba kubuyelwe esimweni somhlangano." )
( govza_0413 "Izinsizwa ezisencane zona zethuka inhlamba." )
( govza_0414 "Kodwa kwaba kuhle nje, ngoba nenkulumo yabafana bayizolo emhlanganweni, yayibangenile." )
( govza_0415 "Siqale sishaye sengathi kasizwa ukuthi bafunani." )
( govza_0416 "Sibakhombe ngale, lapho kufunwa khona imisebenzi." )
( govza_0417 "Bachaze ukuthi cha, bazobona umuntu ogulayo." )
( govza_0418 "Sithi sona asikwazi ukufunda lamagondoviya esandla." )
( govza_0419 "Bese sithi abake balinde sizobuye siyibone indaba yabo." )
( govza_0420 "Balinde kuze kube sengathi bakulowaya mugqa omdala waseposini." )
( govza_0421 "Sishaya indesheni uma imoto kungeyezikhulu." )
( govza_0422 "Bese kuthi uma sisamile sibheke ngakubo sidle imihlathi." )
( govza_0423 "Selicabanga nokuba lithi abobuya kusasa." )
( govza_0424 "Athi usigaxamabhande lona Uyazi yini ukuthi ungaxoshelwa lento oyenzile." )
( govza_0425 "Wakhipha iduku ngokushesha wesula ihlazo ethi: Amanqe noMamba Amanqe noMamba." )
( govza_0426 "Bengingazi ukuthi ungithanda kangaka Makhala." )

( lwazi_0001 "UHenry Fynn ufake ubhememe wesigqoko esinompheme omude." )
( lwazi_0002 "Inhlangano ethile yezemvelo iyophelelwa yisikhathi uma umhlaba ungasasetshenziselwa izinhloso zokongiwa kwemvelo." )
( lwazi_0003 "Uma kunjalo, umhlaba uyobalelwa njengokusebenza kwawo okusha kusukela ngosuku okwaqala ngalo." )
( lwazi_0004 "Uma kunikezwe ngolwazi lomuntu siqu kule webhusayithi, abasebenzisi abafisa ukubuyekeza ulwazi lwabo bangenza lokho ngesicelo sokucela ukubuyekeza, ngokusebenzisa ilinki yefeyisibhuku." )
( lwazi_0005 "Sinesimemezelo esenziwe yilowo muntu esho ukuthi ngokwazi nangokukholwa kwakhe siyiqiniso." )
( lwazi_0006 "Sinesimemezelo lapho esho khona ukuthi, usenze enolwazi lokuthi kungenzeka atholakale enecala, uma ebazi ukuthi akusilo iqiniso." )
( lwazi_0007 "Isilandisostatemente leso sikhonjiswe omunye othintekayo kulolu daba, kusasele okungenani izinsuku eziyisikhombisa ngaphambi kosuku lokuphenywa kodaba." )
( lwazi_0008 "Okuyogxilwa kakhulu kukho wukuxhumanisa izakhiwo ezahlukene zolimi nemisebenzi yokuqhuba umsebenzi wenhlangano ethile." )
( lwazi_0009 "Kwenziwa ngenhloso yokuqinisa igalelo lokudidiyela nokusebenzisa ngendlela egculisayo izinsiza." )
( lwazi_0010 "Noma ngubani ohlola noma olungisa imishini esetshenziswa ekuxhumaneni, ekuhloleni indlela yendiza, noma ukuhlola isimo ngaphakathi endizeni, eyosebenza ngaphansi kohlelo oluthile, kufanele ayihlole ngendlela enqunywe wuMqulu wenhlangano yezokuhlola." )
( lwazi_0011 "Ukuya emtholampilo wabakhulelwe, kwenza ukuthi abahlengikazi nodokotela bakwazi ukuthola kusenesikhathi uma kukhona inkinga." )
( lwazi_0012 "Kubalula ukuthi basheshe bathole ezinye izifo ezingaqubuka ngesikhathi ukhulelwe." )
( lwazi_0013 "Lezi yizifo ezifana noshukela, ukugijima kakhulu komfutho wegazi, ingculazi, izifo ezithathelana ngocansi, nokunye." )
( lwazi_0014 "Abahlongoza ukuthumela impahla ngaphandle kwezwe, kumele bangene engosini ethile ye-inthanethi." )
( lwazi_0015 "Lapha bazothola uhlelo lwe-inthanethi nayo yonke inqubo yokuthumela impahla ngaphandle kwezwe." )
( lwazi_0016 "Kukhona nomunye udokotela esinolwazi ngaye." )
( lwazi_0017 "Wathola sona lesi sifo sofuba emsebenzini wakhe wokwelapha, kumbe ezibhedlela zethu." )
( lwazi_0018 "Kwaholela ekutheni angabe esezwa ngezindlebe zakhe." )
( lwazi_0019 "Owesifazane washonelwa wumyeni wakhe." )
( lwazi_0020 "Wenqaba ukulandela indlela yokuzila ebekwe ezweni lakubo." )
( lwazi_0021 "Bathi achinse ikhambi elibizwa ngemogaga lapho ezohamba khona uma ephuma egcekeni lakwakhe." )
( lwazi_0022 "UMhloli-mabhuku-Jikelele watomula isifundazwe saKwazulu-Natali." )
( lwazi_0023 "Yiso sodwa isifundazwe lapho iminyango eminingi ihambisana nemigomo yokubika ngemisebenzi yomphakathi." )
( lwazi_0024 "Uthi ulwazi esilufaka emibikweni yonyaka iyasebenziseka." )
( lwazi_0025 "Kungethenjelwa kuyo, futhi ihambisana nemigomo ebekiwe." )
( lwazi_0026 "Sindi Opperman awunaso isifo egazini lakho." )
( lwazi_0027 "Kufanele uphinde ubuye emva kwezinyanga ezintathu, ngizolihlola ukuze ngibe nesiqiniseko esigcwele sokuthi uyaphila." )
( lwazi_0028 "Iyoba nomsebenzi wokuqhamuka nemibono efanele ukuthi ivezwe enhlanganweni ethile." )
( lwazi_0029 "Kumele kuvunyelwane ngesimo esifanayo sezikhala nemisebenzi eyosebenza kulo lonke uphiko." )
( lwazi_0030 "Mhh noma kunjalo kufanele ke ngikhulume naye ngimdonse ngendlebe mayelana nokuqonywa njalo." )
( lwazi_0031 "Umnyango uncamela ukuthi kusetshenziswe usizo lwabo ngaphambi kokuthi umuntu asebenzise abeluleki." )
( lwazi_0032 "Iskimu senza kahle kakhulu ngonyaka wezinkulungwane ezimbili nesishiyagalolunye." )
( lwazi_0033 "Siqoqa iminikelo eyeqa izicelo zenkokhelo nezindleko zazo zonke izinhlobo ngaphandle kohlobo lwe-Oniksi." )
( lwazi_0034 "Into engcono ngukuthi wena ugibele kusasa lokhu okusayo uze lapha eMgungundlovu." )
( lwazi_0035 "Abasizakalayo kulo bakhethwa emphakathini empofu ngokwedlulele." )
( lwazi_0036 "Banikwa umsebenzi wokusika utshani kulowo mhlaba kahulumeni okungakhiwe kuwo isikhathi esingunyaka owodwa." )
( lwazi_0037 "Bakhokhelwa njengalabo abasohlelweni oluthile." )
( lwazi_0038 "Ukuphekisisa kahle ukudla kuyawabulala amagciwane adala izifo." )
( lwazi_0039 "Ukunikezwa ukuxhaswa kwamaphrojekthi kanye nemisebenzi esemaphandleni kuyinselele enkulu kuhulumeni." )
( lwazi_0040 "Kudingeka ukusebenza ngempumelelo kwabo bonke ababambi qhaza." )
( lwazi_0041 "Makuqinisekwe ukuthi amaphrojekthi kanye nemisebenzi ifinyelela izidingo zabantu abasezingeni eliphansi." )
( lwazi_0042 "Ungizumelani Jobe." )
( lwazi_0043 "Sezikufake umoya wezikhova lezi zingane zakho." )
( lwazi_0044 "Ufuna ukungibamba ngenzani Jobe." )
( lwazi_0045 "ULwesihlanu lolu hhi, ngiyabuza?" )
( lwazi_0046 "Kuneziphakamiso zokuthi zonke izikhungo ezixubile, zibe ngaphansi kwenhlangano ethile." )
( lwazi_0047 "Lezo eziqondene nemboni ezingaphansi kwaleyo nhlangano njengamanje, zedluliselwe eminyangweni efanele neqondene." )
( lwazi_0048 "Siyaphawula ukuthi abasebenzi baveza umbono wokuthi iNgosi kaZwelonke yokulondoloza amabhuku nemibhalo, sengathi ayithathelwa phezulu uMnyango." )
( lwazi_0049 "Umphathi, ekuceleni kwamalungu esiGungu seziKhalazo noma yiphi ingxenye ngesikhalazo esiziswe ngaphambi kwakhe, angajuba noma ngubani." )
( lwazi_0050 "Lowo muntu aye kulokho okuqhutshwayo, ukuze afakaze, afakwe imibuzo njengofakazi nganoma yiluphi udaba lwalokho kokuqhutshwayo." )
( lwazi_0051 "Akhiphe noma yiphi incwadi, noma into yakhe, noma engaphansi kwakhe lowo muntu, futhi afakwe imibuzo ngayo." )
( lwazi_0052 "USnyman wathi umnyango usisize kakhulu ekuthini siqinise eyezemfundo neyezamazinyo." )
( lwazi_0053 "Ukwenza isibonelo nje, ukugqugquzela ezempilo ukuthi sisebenzise lesi sikhathi ukuthi siphucule nezenhlalakahle." )
( lwazi_0054 "Sizokwazi kahle kamhlophe ukuthi kubonakala sengathi lolu hlelo lusekele luphinde luqinise lezo nezinye." )
( lwazi_0055 "Lokhu kuhlolwa kuzosiza sibheke lezo zinkinga." )
( lwazi_0056 "Luzodluliselwa nasezikoleni, izinhlelo zezempilo esezivelile, izinhlelo esezikhona, kuphawula umnyango ukuthi uthumele izinto ukuqaphelisiswa ngokushesha." )
( lwazi_0057 "Manje baba njengoba ngicele ukuhlangana nawe, yingoba ngifisa ukuzwa ukuthi ngimi kuphi." )
( lwazi_0058 "Angikwazanga ukuza kuyinhlolo-khono ngephimbo elinokudangala." )
( lwazi_0059 "Bandakanya umfanekiso weSaziso seNhlawulo enikwe lowo osolwa ngecala umsolwa." )
( lwazi_0060 "Balula isizathu ngezinyathelo ezithathiwe; kanye nobufakazi bokuthunyelwa kwesaziso seNhlawulo kumsolwa." )
( lwazi_0061 "Akulula kangako ukuncintisana nolwazi lomnotho womhlaba." )
( lwazi_0062 "Kuphela kungaba ngaphandle kwamanani aphansi athembekile kanye natholakala kabanzi kwamaza okuxhumana." )
( lwazi_0063 "Iziboshwa kumele zifunisise kuMphathi weJele uma befuna ukubeka isikhathi sokubonana nezikhulu." )
( lwazi_0064 "Walugxavula sekuthe xhifi enhliziyweni yakhe yilesi senzo sikaThami." )
( lwazi_0065 "Ukuphela konyaka wezimali ngoFebruwari kubanga ubunzima kwezezimali." )
( lwazi_0066 "Kumele kutholwe imvume evela eNhlanganweni yezeNtela, ukufakela izitatimende zezimali ngosuku olwehlukile kunolukaFebruwari." )
( lwazi_0067 "Abantu abanjalo bangacela imvume yokufakela imibiko yentela yesikhashana ngokuhambisana nokuphela konyaka wezimali okwamukelekile." )
( lwazi_0068 "Umbhalo ochaza ngohlelo lokucutshungulwa kwamanani empahla esikhumulweni esibheka impahla engenayo nephumayo." )
( lwazi_0069 "Umbhalo ochaza kabanzi ngeNtela eqoqwa kwinzuzo etholakala lapho umuntu esedayisa umuzi wesibili." )
( lwazi_0070 "Umbhalo ochaza ngokucutshungulwa kwamanani ezindlu ezingezona ezokuqala, ngenhloso yokuqoqa iNtela enzuzweni lapho sezidayisa." )
( lwazi_0071 "Inhlangano ethile kuzolindeleka futhi ukuthi ihlole amamaki." )
( lwazi_0072 "Bazobona ukuthi akunamaphutha yini, ukuqinisekisa, ngaphambi kokuthi bawathumele emahhovisi esifunda." )
( lwazi_0073 "Ngamagama alula, ukuthuthukiswa komphakathi kusho imizamo ewusizo kaHulumeni, nokusebenza ndawonye ekubhekeleni izidingo ezinqala zemiphakathi ngokwenza ubungcono ezimpilweni zabo." )
( lwazi_0074 "Ukwenza ngcono ukwethulwa kwezinsiza, nokuveza amathuba angcono emisebenzi." )
( lwazi_0075 "Inhlangano ethile yeluleka ukuthi indlela eyiyo yokuvimbela ukutheleleka ngomkhuhlane wezingulube ukulandela izindlela zokuvimbela ngokukhulu ukucophelela." )
( lwazi_0076 "Noma yikuphi ukuphawula okuvela kwilungu lombuso elinamandla omkhawulo womthetho engxenyeni yomsebenzi okuyisihloko sesicelo." )
( lwazi_0077 "Nanoma yimiphi imihlahlandlela yesicelo." )
( lwazi_0078 "Uma kunengxabano ngesikhathi somshado wobuSulumani, noma ngenxa yawo uqobo, othintekayo kulowo mshado angayidlulisa." )
( lwazi_0079 "Ngaphambili noma ngemuva kokuqala izinyathelo zomthetho ezihlonzwe yisigaba." )
( lwazi_0080 "Ngaphambi kwesinyathelo sesahlulelo senkantolo eMkhandlwini wabaXazululi omiswe ngendlela enqunyiwe." )
( lwazi_0081 "Wazethula-ke uSonny kuXaba wamtshela nokuthi uzwe kuthiwa uthenga lo msebenzi awukhiqizayo." )
( lwazi_0082 "Thola ulwazi kothumela kuye impahla, noma ummeli walelo lizwe elamukela impahla." )
( lwazi_0083 "Ziyini izimo zokuhlolwa kwezifo zezilwane kulelo lizwe elamukela okuvela kuwe." )
( lwazi_0084 "Izinsolo zokungasetshenziswa ngendlela kwamandla okulalela amacala ngabaholi bendabuko, yilabo abakholelwa ekutheni amadoda kumele aphathe." )
( lwazi_0085 "Abakholelwa ukuthi kuqhubeke kukhishwa inyumbazana abesifazane ezinkantolo zendabuko, nokubophela abesifazane amanqina enyathi enqubweni yasezinkantolo." )
( lwazi_0086 "Sivikele ukungasetshenziswa ngokuyikho kwamandla, nokuqinisekisa ngokukhululeka ukusebenzisa amachweba ngokulinganayo." )
( lwazi_0087 "Ukutholakala kosizo lwamaChweba ukuqaphela nokuthatha izinyathelo ezifanele uma kudingekile, ukuze kuqinisekiswe ukuthi iSigungu seziPhathimandla zamaChweba kuZwelonke, azitholi ukwenzelelwa okungafanele ngaphezu kwezinye izinkampani zezokuthutha." )
( lwazi_0088 "Ukuthi izimali eziqoqwe iziphathimandla zamaChweba, zisentshenziselwa ukuzuzisa nokwenziwa ngcono kwezingqalasizinda zamaChweba, nokuzuzisa abasebenzisi bamaChweba." )
( lwazi_0089 "Uma uzohlangana nenye imoto ngesikhathi ushayela endaweni eyijika ngasohlangothini lwesokunxele, nciphisa izibani zakho zemoto kusenesikhathi." )
( lwazi_0090 "Uma kungenjalo izoshelela nejika bese ixhopha omunye umshayeli." )
( lwazi_0091 "Ngaphezu kwalokhu, uhlelo lomsebenzi lwenhlangano yentuthuko ye-Afrika, nezinkulumo zabaholi bale nhlangano, sekubeke i-Afrika nezinhlelo zayo eziphambili ohlelweni lomsebenzi lomhlaba wonke." )
( lwazi_0092 "Kodwa kusenezinkinga ezinzima ezivumbuka kwezinye izingxenye zomhlaba." )
( lwazi_0093 "Akekho umuntu ozovezela omunye ulwazi alutholile ngenkathi enza imisebenzi ngokulandela lo Mthetho." )
( lwazi_0094 "Noma umthethosisekelo womphakathi wokufuya izilwane, noma umthethosisekelo wesiphathimandla esibhalisayo futhi esiphathelene nebhizinisi." )
( lwazi_0095 "Noma izindaba zomunye umuntu, ngaphandle kwemvume ebhaliwe yomuntu onjalo." )
( lwazi_0096 "Ngaphandle nje uma loku kudingwa yinoma yiyiphi inkantolo yomthetho, noma ngaphansi kwanoma yimuphi umthetho." )
( lwazi_0097 "Uma indiza esebenzisa izinsiza ihamba ebusuku ezindaweni ezithile, umshayeli oqaphile uyoba nemvume efanele yokusebenzisa izinsiza zendiza." )
( lwazi_0098 "Siphezu komsebenzi wokwakha amakhaza amasha." )
( lwazi_0099 "Sikhathazeke kakhulu ngesimo esingesihle samanye amakhaza abengaphansi kwamaphoyisa, ikakhulukazi amakhaza asemgwaqeni othile." )
( lwazi_0100 "Kunezikhali zokuqikelela ukuthi imisebenzi kahulumeni wendawo ididiyelwe nezinye izinhlaka zokuhlela intuthuko." )
( lwazi_0101 "Ezingeni lesifundazwe, kuzwelonke nasemhlabeni jikelele." )
( lwazi_0102 "Ilungelo eligcwele noma elinqunyelwe liyanikezwa ezinhlobeni ezithile zezinhlanzi, yigatsha lenhlangano ethile." )
( lwazi_0103 "Ngokubheka inani elivunyelwe lokudotshwa kwezinhlanzi elinqunywa njalo ngonyaka ngungqongqoshe wegatsha eliphethe izindaba zenhlalo yendawo, nezokuvakasha." )
( lwazi_0104 "Uhlelo lokususwa ezindlini uye kwenye, ukuba lube yisu lokulungisa isimo esifanele lalezi zindlu." )
( lwazi_0105 "Lolu hlelo lwenziwa ngokuhlanganyela ezinkampanini zamabhange nohulumeni ukuba axhumanise ekusebenziseni uhlelo lokubekwa kabusha, ukuze kulungiswe isimo esifanele sezindlu." )
( lwazi_0106 "Njengoba inkonzo yezisebenzi zikahulumeni izilungiselela inkambiso yokuhlinzeka izinsizakalo ngendlela yama-elekhthronikhi, isidingo sohlobo olwahlukile lokuvikeleka kolwazi enkonzweni yezisebenzi zikahulumeni siba yimpoqo." )
( lwazi_0107 "Umphathi welayisense yokucwenga, akakwazi ukwenza yinoma yimuphi umsebenzi onikezwe imvume yilayisense kunoma yiyiphi indawo." )
( lwazi_0108 "Nisho noma kusendaweni yokusebenzela echazwe yilayisense, noma echazwe yimvume yelayisense ngokulandela isigatshana sesithupha." )
( lwazi_0109 "Oyiphethe akakwazi ukuphatha okusansimbi okuyigugu, kunoma yiyiphi indawo, ngaphandle kwasendaweni yakhe yokusebenzela, noma endaweni echaziwe." )
( lwazi_0110 "Angakuphatha uma ethutha okusansimbi okuyigugu, okungasetshenzisiwe ngokulandela isigaba seshumi nanye." )
( lwazi_0111 "Ngakho, intuthuko yohlelo lwamagama olimi kuyo yonke imikhakha, iyoba semqoka kakhulu idinge ukusebenzisana kwababambe iqhaza." )
( lwazi_0112 "Kufakwe namathimba nezigungu zolimi." )
( lwazi_0113 "isibonelo, izakhiwo ezincane zenhlangano yezolimi ezifana namathimba kazwelonke esayense yezichazimazwi, izigungu zikazwelonke zolimi namakomidi olimi kwizifundazwe." )
( lwazi_0114 "Ikomiti lokuqondisa, lasungulelwa ukubhala umbhalo ozophakamisa inqubo engasetshenziswa ukusungula imboni ezoqhakaza, ikhulise izilimi zaseNingizimu Afrika." )
( lwazi_0115 "Esamile kanjalo kwaqhamuka enye yezimoto ezithutha umphakathi oya edolobheni eKranskop." )
( lwazi_0116 "Uma ofake isicelo ethola inzuzo yokungasebenzi, enqabe noma ale ukuthatha umsebenzi ofanele ngaphandle kwesizathu esizwakalayo." )
( lwazi_0117 "Noma ale ukuyoqeqeshwa noma ukwelashwa, isikhulu sezicelo singanquma ukuthi obefaka imali eSikhwameni angayitholi inzuzo." )
( lwazi_0118 "Kuyoze kuphele isikhathi esingengaphezu kwamasonto ayishumi nantathu." )
( lwazi_0119 "Ukusebenzisa amehlo kuchaza iqhinga lokundiza." )
( lwazi_0120 "Lapho ingxenye ethile noma yonke yenqubo yethuluzi ingaqedwa kanjalo futhi ukuhlala kwenziwa ngokubuka umzila wendiza." )
( lwazi_0121 "Ngabe wonke umuntu eqenjini sewake wakhuluma yini esidlangalaleni." )
( lwazi_0122 "Buza-ke abaqeqeshwayo ukuthi kungani becabanga ukuthi, ukukhuluma esidlangalaleni, kubalulekile kumakomidi ezigceme?" )
( lwazi_0123 "Kufanele futhi ukuba sizinikele ukuba sizokuzikhandla ukwenyusa izinga lethu lolwazi ngendlela eqhubekayo." )
( lwazi_0124 "Kuzosenza siqhathaniseke ngendlela ephezulu ezweni lethu nakwamanye amazwe." )
( lwazi_0125 "Kuzonikeza nabantu isiqinisekiso sokuthi ukuzithuthukisa ngamakhono akusiyona into yokuchitha isikhathi, kodwa kunembuyiselo." )
( lwazi_0126 "Kufanele basebenzise uhlu lwezihloko kanye nezigaba zolwazi oluphethwe isekela lomsebenzi wolwazi ngalinye." )
( lwazi_0127 "Ukuze bakwazi ukunquma ukuthi yiliphi isekela lomsebenzi wolwazi ongahle kube linerekhodi." )
( lwazi_0128 "Bese bebhala izicelo zabo baziyise kulelo sekela lomsebenzi wolwazi." )
( lwazi_0129 "Isicelo sokuvuselela isitifiketi semvume siyokwenziwa ngokugcwalisa ifomu enqunywe uMqulu." )
( lwazi_0130 "Futhi siphelezelwe yimali efanele njengoba inqunyiwe yiNgxenye yekhulu namashumi ayisishiyagalombili nesikhombisa." )
( lwazi_0131 "Noma yimuphi umuntu obizwe ukuba abe khona ekuhlaleni kweBhodi njengofakazi, noma onikeze ubufakazi ngaphambi kweBhodi." )
( lwazi_0132 "Lowomuntu unelungelo lokucela izindleko ezivelile emalini yomphakathi, ngokwesilinganiso esisebenza kufakazi ecaleni lezakhamuzi enkantolo kamantshi." )
( lwazi_0133 "Inhlangano ethile iyofaka imali kumacebo amasha, kuzo zonke izinhlaka zomphakathi, nasembonini ezimele." )
( lwazi_0134 "Kanjalo ezigabeni ezehlukene, okungasukela ekucatshangweni kwecebo, kuze kufike ekwethulweni komkhiqizo emphakathini." )
( lwazi_0135 "Nakuba uyobheka isigaba sokusungulwa kwecebo okunezindleko ezinkulu, nokwemukelwa komkhiqizo wumphakathi lapho usudayisa, ungeniswa noma usatshalaliswa." )
( lwazi_0136 "Uma ofake isicelo esethule kwiNhloko yesiFundazwe ephawulwe kuleli bhuku, iNhloko yesiFundazwe eqondene, iyobhala phansi isicelo somlomo." )
( lwazi_0137 "Iyobe isinika ofake isicelo umbhalo ofanayo waleso sicelo." )
( lwazi_0138 "Induna yomkhumbi kufanele iqiniseke ukuthi isikhulu nabasebenzi bomkhumbi basezindaweni zabo, nokuthi baqaphile." )
( lwazi_0139 "Futhi umkhaphi unikezwa lonke usizo ekwenzeni umsebenzi wakhe." )
( lwazi_0140 "Intsha kufanele yephuze ukuya ocansini okokuqala, yenze izinqumo ezenziwe ngokwazi ukuvimbela ukukhulelwa okungadingekile nezifo zegciwane lengculazi." )
( lwazi_0141 "Uzokwenza isiqiniseko sokuthi inqubo yecala yenzeka ngendlela yokuthi ayihlukumezi amalungelo akho okukuphatha ngenhlonipho." )
( lwazi_0142 "Ukubamba isithunzi sakho, nelungelo lakho lokuhlonipha ubuwena nezimfihlo zakho." )
( lwazi_0143 "Lapho umsebenzi ezikhethela yena ukuveza isimo sakhe sokuba negciwane lengculazi kumqashi wakhe, kumbe ozakwabo." )
( lwazi_0144 "Lolu lwazi alufanele bese lusakazwa lutshelwa nabanye, ngaphandle kwemvume yomninilo futhi ebhalwe phansi." )
( lwazi_0145 "Umfundi ofuna ukungena esikoleni okokuqala ngqa ekuqaleni konyaka wesikole, kufanele abhalise kuso." )
( lwazi_0146 "Ukwenza ekuqaleni kuka-Agasti kuya ekupheleni kuka-Septhemba, wonyaka wangaphambili kokuqala kwakhe esikoleni." )
( lwazi_0147 "Uma kukhona into engingayiqondisisi kumbe engifuna ukuyibuza, uLouis nguye oya kudokotela ayongibuzela angisize nangayo yonke indlela." )
( lwazi_0148 "Imithethonkambiso okukhulunywa ngayo kulesi sigaba ingamisa amacala kanye nokuhlawulisa inhlawulo." )
( lwazi_0149 "Noma ukugcinwa ejele isikhathi esingeke saba ngaphezulu kwezinyanga eziyisithupha, noma kokubili inhlawulo nokugcinwa ejele." )
( lwazi_0150 "Uma ushayela inhlangano yezempilo, ungalindela ukuqondiswa okunolwazi kokuthi ungaya nini ekhemisi ukuze uthole imithi." )
( lwazi_0151 "Leyo oyithenga ngaphandle kwemvume kadokotela, uma udinga iseluleko sikadokotela, noma uma kumele ungeniswe esibhedlela ngokushesha." )
( lwazi_0152 "Incwadi kumele ibe wubufakazi bokuthi ukufanele ukubhalisela noma ukubamba iqhaza ohlelweni." )
( lwazi_0153 "Futhi kumele kukhombise ukuthi inhlangano, noma umndeni uzobhekana nawe ngesikhathi uhlezi eNingizimu Afrika." )
( lwazi_0154 "Ngale kokunciphisa amandla okukhulunywa ngawo, kusigatshana sokuqala, inkampani iyakuba namandla okuba ikhokhelwe imali kweminye imithombo." )
( lwazi_0155 "Lokhu kungale kwezintela, inkokhelo okubandakanya noma kungesilokhu kuphela, amandla okuphoqa ukuba kulandelwe isivumelwano." )
( lwazi_0156 "Leso esimayelana nalokho kwenza izindlela zokuthola imali, ukuboleka imali kuyokwenziwa ngokulandela isigaba samashumi ayisithupha nesithupha." )
( lwazi_0157 "Yisigaba soMthetho wokuphathwa kwezimali zoMbuso." )
( lwazi_0158 "Anibheke nje kodwa bafowethu, ngasho ngikhomba inhlabaluhide yomugqa wezalukazi namakhehla, alinde ukuhola imali yawo yempesheni yanyanga zonke." )
( lwazi_0159 "Siyethemba kulokhu ukuthi le yimizamo yomphakathi wamazwe omhlaba evuselelwe kabusha, yokuthola isixazululo sesikhathi eside sale ngxabano." )
( lwazi_0160 "Izothela izithelo, ukuze abantu bakwa-Israyeli namaPhalestina bezokwazi ukuphila ngokuthula nokuvikeleka." )
( lwazi_0161 "Njengomakhelwane ezindaweni ezizimele." )
( lwazi_0162 "Iphothfoliyo iqoqomibhalo, iyindlela yokuhlola enikeza bobabili umfundi nothisha amathuba okubheka umsebenzi owenzelwe." )
( lwazi_0163 "Imisebenzi yokuhlola eminingana." )
( lwazi_0164 "Inhlangano ethile inganika umyalo wokwenza kuphela ifuna, ukuqinisekisa ukulandelwa kwesibopho esinikwe umkhumbi olawulwa kwelinye izwe." )
( lwazi_0165 "Ngaphansi kwale mithethonkambiso, noma mayelana nezinyathelo ezithile ezenza ngcono ezokuvikela olwandle." )
( lwazi_0166 "Njengoba kubekiwe kwesinye iSahluko." )
( lwazi_0167 "Isiyingi sezinsuku zekhefu lokugula sibalwa ngokuthatha izinsuku ezinhlanu, ziphindwe kasithupha." )
( lwazi_0168 "Kube sekutholakala izinsuku ezingamashumi amathathu esikhathini seminyaka emithathu." )
( lwazi_0169 "Uma oshonile wayengumyeni oshade abafazi abaningi, kuphila abafazi abangaphezu koyedwa, inani lefa lingaphansi kwamaRandi ayikhulu namashumi amabili nanhlanu ezinkulungwane." )
( lwazi_0170 "Abalingani abaphilayo bazakuhlukaniselana inani elisele ngokulinganayo ngaphakathi kwabo." )
( lwazi_0171 "Bangafaki izingane kanye namanye amalungu omndeni." )
( lwazi_0172 "Ukubonelelwa kwesicelo sakho kuqala ngosuku ofakela ngalo isicelo sakho sokusekelwa kwabantu abahluphekile." )
( lwazi_0173 "Isicelo sakho sizohlolwa ebese kwenziwa isinqumo sokuthi ngabe ukufanele yini ukuthola izinkonzo zesisekelo zamahla noma cha." )
( lwazi_0174 "Ikomidi likahulumeni noma elinye lamakomidi angemukela amaphethishini, izethulo noma izincwadi zezethulo." )
( lwazi_0175 "Lezi ziqhamuka kunoma ngobani noma izikhungo ezinentshisekelo." )
( lwazi_0176 "Sesizokwazi manje ukusheshisa uhlelo lwethu lokubhekana ngqo nokuqedwa kwemijondolo." )
( lwazi_0177 "Kanye nokwakhela abantu izindlu ezindaweni zasemakhaya ezifana nalapha, sibuyise nesithunzi sabantu bakithi emahhostela." )
( lwazi_0178 "Sekube khona ukudideka okukhulu ngamagama emithi ikakhulukazi esikhathini esedlule." )
( lwazi_0179 "Ikakhulukazi ngamagama ezinto okuyizona ezisebenzayo emithini leyo." )
( lwazi_0180 "Yinoma imuphi umfanekiso noma isitatimende esikhiqizwe kabusha, sase siqinisekiswa uKhomishini ofungisayo ukuthi singumfanekiso woqobo." )
( lwazi_0181 "Noma yiwona ngqo umkhiqizo waleso esiyiso." )
( lwazi_0182 "Umnikazi wemoto okuthwelwe ngayo umuntu, uthathwa ngokuthi uye obethwele lowo muntu ngesikhathi athwalwe ngaso." )
( lwazi_0183 "Ngaphandle uma kutholakala ukuthi ngaleso sikhathi ubengesiyena umshayeli waleyo moto." )
( lwazi_0184 "Futhi akazange akuvumele ukusetshenziswa kwaleyo moto ukuthi ihambise umuntu." )
( lwazi_0185 "Uma kungathi ilungu loMbutho oseMbuthweni Osebenza Ngokuphelele, linikezwe imvume yokuqala umsebenzi oweHlukile ngenkathi liqashwe eMbuthweni wezokuVikela." )
( lwazi_0186 "Izintshisekelo zoMbuso ziza ngaphambili uma kuvela ukungqubuzana phakathi koMbuso  wezokuVikela nomunye umsebenzi owenziwa oseceleni." )
( lwazi_0187 "Futhi ilungu elithintekayo kufanele lesule emsebenzini." )
( lwazi_0188 "Noma lisuke esikhundleni salo okwesikhashana emsebenzini walo omunye, uma liyalelwa ukuba lenze kanjalo nguMbutho wezokuVikela." )
( lwazi_0189 "Noma imuphi umuntu onesikhalo owoniwe yinoma imuphi umyalo owenziwe inkantolo yokulingana, njengokuyalela kwayo." )
( lwazi_0190 "Noma ngaphansi kwalo Mthetho, angawedlulisa lowo myalo obhekene naye eNkantolo ePhakeme enesikhundla samandla omthetho." )
( lwazi_0191 "Noma kwinkantolo ePhakeme yokweDlulisa, kuye ngesimo, isigungu seziPhathimandla kufanele sihlanganyele neziphathimandla okudingeka zenze le misebenzi eChwebeni." )
( lwazi_0192 "Ukungena kwabantu abangezona izakhamuzi zaleli zwe, imali yokuthelela impahla ephumayo noma engenayo ezweni." )
( lwazi_0193 "Ukugcinwa komthetho, futhi kufanele banike lezikhulu zonke izinto zokusebenza, ngokuhambisana nesinxephezelo, okungavunyelwana ngaso phakathi kweSigungu seziPhathmandla naleso siphathimandla soMbuso esithintekayo." )
( lwazi_0194 "Uma behluleka ukufinyelela esivumelwaneni, uNgqongqoshe nguyena oyakumisa isinxephezelo." )
( lwazi_0195 "Umfundi lapha uzokwazi ukuthi afunde abuye abheke okuthile emibhalweni, ukuze athole ulwazi noma-ke efundela nje ukuzijabulisa." )
( lwazi_0196 "Lokhu kuzomenza ukuthi aqale ukubona ubuhle amasiko kanye nemizwa ngalokho okubalulekile okusemqoka." )
( lwazi_0197 "Enye into eyinselelo kakhulu yilena yezifo ezithathelwanayo, ikakhulukazi igciwane  lesandulela ngculazi nesifo sengculazi uqobo." )
( lwazi_0198 "Okuyinto eyande kakhulu kithi ngenxa yesimo sobuphofu, nokungabi nezindawo zokuhlala ezamukelekile." )
( lwazi_0199 "Ilayisense enikezwe ngokulandela uMthetho, inikeza onelayisense amandla ukuthi awasebenzise, enze imisebenzi ekulayisense kanye nakulowo Mthetho." )
( lwazi_0200 "Ngakhoke akekho onelayisense ongadlulisa noma enzise abanye nanoma yimaphi amandla noma umsebenzi." )
( lwazi_0201 "Kunoma yimuphi umuntu ngaphambi kwemvume yoMlinganisi." )
( lwazi_0202 "Ukuxazulula amaphuzu abalulekile aqondene nentsha nabantu besifazane." )
( lwazi_0203 "Kuwona onke amazinga okubuswa kwendawo ngokusebenzisa izinhlaka zomphakathi ezihlelekile." )
( lwazi_0204 "Isinyathelo sokuqala sokuthola isisindo sakho esifanele, kungaba ukuqonda ukukalwa kwamafutha omzimba okugxile ebudeni nasesisindweni." )
( lwazi_0205 "Wayefuna nje athi efika umshana naye abe engena indlela elibangise kuSkheshe." )
( lwazi_0206 "Kusho izibalo ezikhombisa isimo sokuthi bangaki abantu abadala abangenayo imfundo eyisisekelo." )
( lwazi_0207 "Nanoma yimuphi umsebenzi osunikezwe imali ngesinye isikimu sikahulumeni, noma isikhungo esiyingxenye kahulumeni." )
( lwazi_0208 "Noma othola noma yikuphi ukwesekwa ngezimali, kunoma yimuphi omunye umuntu ngaphandle kwebhizinisi." )
( lwazi_0209 "Bangichazela ukuthi, ukuba negciwane lesandulela-ngculazi nokungathathi imithi yokulidambisa, uma kunesidingo." )
( lwazi_0210 "Lokhu kufana nokushiya iminyango namawindi ekhaya lakho kuvuliwe ube wazi ukuthi  izigebengu ziyeza." )
( lwazi_0211 "Kusukela ezimvweni ezinikiwe zalo mhlangano wokuthola imibono neziphakamiso ezenziwe, kwaba nokuvumelana ezindaweni eziningi." )
( lwazi_0212 "Izindawo ezithinta uhlelo lwezinkantolo zendabuko, imisebenzi ebekelwe abaholi bendabuko njengabantu abalalela amacala ezinkantolo zendabuko." )
( lwazi_0213 "Kumele isekelwe ekutheni baye kothola ukuqeqeshwa, ukuthuthukiswa kwemigomo yokuziphatha ebekelwe abaholi bendabuko." )
( lwazi_0214 "Ukushiywa ngaphandle kokumelwa emacaleni, ekuqulweni kwamacala ezinkantolo zendabuko nokwenziwa kwezinhlelo ezigqugquzela ukulingana ngokobulili." )
( lwazi_0215 "Abashadiswe ngaphansi kwenhlanganiso yomdabu, babengathathwa njengabantu abashade ngokusemthethweni." )
( lwazi_0216 "Noma yinini omunye wabo ngaphansi kwalowo mshado, wayengabopha ifindo lomshado wesilungu nomunye umuntu." )
( lwazi_0217 "Bonke abanamalungelo ezimotweni, nabanikazi bezimoto kumele baqinisekise ukuthi amakheli abo abhaliswe encwadini yezimoto, ayiwo uqobo." )
( lwazi_0218 "Umthethosivivinywa uzimisele nokwengeza izinsuku ezibekiwe zezinhlelo ezithile." )
( lwazi_0219 "Ukuze unikeze iziphathimandla ezihlelayo isikhathi esanele sokufaka ulwazi." )
( lwazi_0220 "Kanye nokusebenzisa izinhlelo zazo njengoba kudingwa nguMthetho." )
( lwazi_0221 "Wangena uKapteni Qeda edlubhe inyumfomu iphelele, kulenga nezindondo, nemicu ekhombisa ukuthi yiphoyisa elidle ngokuhlabana." )
( lwazi_0222 "Ngokombono wakho ingabe ukusetshenziswa kwezibuko kube nesidingo ngenxa yomphumela ngqo wengozi?" )
( lwazi_0223 "UMkhandlu kufanele uqinisekise ukuthi indlela yokuziphatha enqunyiwe yocwaningo  oluphathelene nomsebenzi wobuhlengikazi, iyalandelwa." )
( lwazi_0224 "Futhi ungathatha izinyathelo zokuqondisa izigwewge ezifanele, kumuntu owephula leyo nkambiso, noma imuphi umthetho." )
( lwazi_0225 "Umfundi uzokwazi ukuthi alalele ukuze athole ulwazi nokuthi akwazi ukujabulela leyo nto asuke eyilalele." )
( lwazi_0226 "Futhi uzokwazi ukubhekana nezimo ezahlukahlukene zempilo angahle ahlangabezane nazo." )
( lwazi_0227 "Abenhlangano yezeNtela bazobonelela isicelo sakho, nokwenza isinqumo sokugcina ngokuthi wenze amalungiselelo okukhokha kamuva." )
( lwazi_0228 "UNgqongqoshe ofanele enze isaziso sokuphawula kuMqulu kaHulumeni." )
( lwazi_0229 "Kunoma yimuphi umthetho ophakanyisiwe okungenani izinyanga izithathu, ngaphambi kokuthi usetshenziswe." )
( lwazi_0230 "Izindlela namazinga asetshenzisiwe ekwakheni izinqolobane zolwazi, kumele zihlanganiswe nezinye izinhlelo zamazwe ngamazwe." )
( lwazi_0231 "Lokhu kwenzelwa ukuze ukufunwa kolwazi okuhambisanayo kube khona." )
( lwazi_0232 "Ngeshwa-ke, lo msebenzi usadinga ukulolongisiswa, ukuze usetshenziswe ngempumelelo ukwelekelela ukulandelwa kwezilimilimi." )
( lwazi_0233 "Futhi kukhuthazwe nezikhungo ukuthi nazo zakhe imithetho-migomo yezilimi, ezokwazi ukulungisa ukungalingani kwesikhathi esidlule." )
( lwazi_0234 "Isinqumo sokususa ilungu emkhandlwini wokwedluliselwa kwezindaba singaphansi kombandela wokungaziphathi kahle." )
( lwazi_0235 "Noma wokwehluleka ukwenza umsebenzi, kufanele kweyame ekutholakaleni kobufakazi obumayelana nalokhu." )
( lwazi_0236 "Yilowo oqokwe nguNgqongqoshe wesifundazwe ukuba aphenye lolo daba." )
( lwazi_0237 "Ukuphindwa kabili kosizo lwezentuthuko eminyakeni emithathu nokukhuliswa." )
( lwazi_0238 "Ukuze kuqinisekiswe ukuthi i-Afrika iyakwazi ukuhlangabezana nezidingo ezithile, ngokwezinkulungwane ezimbili neshumi nanhlanu." )
( lwazi_0239 "Lokhu kwenzelwa ukuthi uthole umazisi ngemuva kokuba kwamukelwe isicelo sakho sokuba yisakhamuzi sezwe, kodwa esivela kwelinye izwe." )
( lwazi_0240 "Zikhona yini izinto ongazicabanga, ezingenza ukuthi impilo yomama nabantwana ibe ngcono." )
( lwazi_0241 "Futhi inikeze abantwana kanye nezingane ezisencane isiqalo sempilo esiphilile." )
( lwazi_0242 "Ngemuva kokuthola isikhalo, kumelwe iphenye noma yikuphi ukungaziphathi kahle." )
( lwazi_0243 "Noma ukwephula umthetho okwenziwa yilunga loMbutho wamaPhoyisa aseNingizimu Afrika noma isigaba esithile." )
( lwazi_0244 "AmaRandi ayikhulu ngosuku noma ingxenye yosuku, okudingeka ukuba ufakazi abe senkantolo ngalo." )
( lwazi_0245 "Angazichaza ngokwanelisayo izindleko, zokuza enkantolo, kanye nezindleko zokuthenga ukudla asuke angene kuzo ufakazi ngenxa yokuza enkantolo." )
( lwazi_0246 "Alikho icala noma izindleko eziyothweswa uHulumeni, ngenxa yokulimala kwempahla yabavakashele ihlathi likaHulumeni." )
( lwazi_0247 "Kulandela imisebenzi eyenziwa nguHulumeni noma eyenziwa egameni likaHulumeni, noma ngenxa yanoma ngabe iyiphi imbangela." )
( lwazi_0248 "Ngaphandle uma lokho kulimala kudalwe ubudedengu babasebenzi bakaHulumeni, lapho benza umsebenzi wabo wangemihla ngemihla." )
( lwazi_0249 "Inhlangano yesikhashana iyohlala isebenza, kuze kuphele isikhathi esinqunyiwe kuyona,  kodwa esingeze sadlula izinyanga eziyisithupha." )
( lwazi_0250 "Inhlangano ethile iphokophelela ukufinyelela emiphakathini yasezindaweni zasemakhaya, engazi ukuthi le nqolobane eyokwenzani njengalokhu." )
( lwazi_0251 "Nayo inamalungelo okuthola ulwazi." )
( lwazi_0252 "Kunesigungu somhlaba esinquma umhlahlandlela nenqubo okumele ilandelwe, cishe yizo zonke izigungu zamagama ezindawo emhlabeni jikelele." )
( lwazi_0253 "Esikhathini eside abaqashwa kanye nabameleli bomphakathi, kumele bakwazi ukukhuluma ezinye zezilimi ezisemthethweni." )
( lwazi_0254 "Ukuze bakwazi ukwethula izinsiza ngempumelelo nangokufanele." )
( lwazi_0255 "Umnikazi womhlaba wazisa uMphathiswa ukuthi umhlaba uzolinywa noma uzothuthukiswa ngemuva kosuku." )
( lwazi_0256 "UMphathiswa aqale ngalo ukuchezulela amanzi emvula kuwo, uMphathiswa angaqhubeka nalokhu kukhipha amanzi ngendlela angayibona inomqondo." )
( lwazi_0257 "Ukuze anciphise umonakalo ongadalwa amanzi emvula ngokuvumelana nomnikazi, futhi ngezindleko zakhe." )
( lwazi_0258 "Umnikazi akayukufuna lutho kuMphathiswa mayelana nalokhu." )
( lwazi_0259 "Hheyi, unginqumele ugwayi katiki wathi nakanjani angize kuye ngokukhulu ukushesha lokhu." )
( lwazi_0260 "Inhlangano ethile yeseka ukuhlinzekwa kokuxhumana kwentuthuko." )
( lwazi_0261 "Lokhu kwelula izakhiwo zokwazisa zikahulumeni, ngokusebenzisa ukubambisana nohulumeni bezifundazwe kanye nabasekhaya." )
( lwazi_0262 "Qhelisa izingubo nezinwele ezinde ezithweni ezinyakazayo." )
( lwazi_0263 "Lapho indlela yokungena noma ukuphuma emgwaqweni wesifundazwe isebenzela indawo eyodwa, umnikazi kumele ayigcine esimeni esihle." )
( lwazi_0264 "Iphakathi nonqenqema lomgwaqo nomngcele wendawo yomgwaqo, ngendlela eyanelisa uMphathiswa." )
( lwazi_0265 "Ngezindleko zomnikazi wendawo, kanti uMphathiswa nesithunywa, noma umsebenzi wesiFundazwe abayikuphendula ngokulahlekelwa." )
( lwazi_0266 "Noma ukonakalelwa kwanoma ngubani, ngenxa yanoma yikuphi ukwenza, noma ukuphutha komnikazi wendawo ngaphansi kwalesi sigatshana." )
( lwazi_0267 "Shayela ucingo leyo nkantolo yesondlo." )
( lwazi_0268 "Uqinisekise ukuthi yini okudingeka ukuthi uze nayo ukuze ufake isicelo semali Yesondlo." )
( lwazi_0269 "Xoxa ngemibuzo elandelayo ethathelwe odabeni olufingqiwe, nolwazi olutholwe ezahlukweni zalo Mthetho." )
( lwazi_0270 "Lokhu akwenziwe ngamaqoqo, bese nizama ukuphendula imibuzo elandelayo." )
( lwazi_0271 "Inani lentela yendawo ohlelweni lwendawo lapho kwakhiwe khona, ngokuhlanganyela egcekeni elolodwa." )
( lwazi_0272 "Kufanele liklanywe ngokwehluka kuye ngobungako baleyo naleyo ndawo okufanele, ikhokhelwe kulolu hlelo, hhayi ukuthi kuklanywe inani elilodwa elihlanganisa indawo yonkana." )
( lwazi_0273 "Vama ukuhambisa umntwana wakho ekliniki yabantwana ukuze athole ukuxilongwa okwejwayelekile nemigomo edingekayo." )
( lwazi_0274 "Umbiko abanikezwe wona kanye nayo yonke imibono yomphakathi iyoba yingxenye yalombiko." )
( lwazi_0275 "Lo mqulu uchaza inqubomgomo kaMasipala waseThekwini, kanti kufanele ufundwe nomqulu othile." )
( lwazi_0276 "Kumelwe kuqinisekiswe ukuthi uMkhandlu wenza umsebenzi wawo, futhi ufeza izinjongo zawo ngokwalo Mthetho." )
( lwazi_0277 "Ulandela noma ikuphi okushiwo yilo Mthetho." )
( lwazi_0278 "Kuqinisekiswe ukuthi imali eyabelwe uMkhandlu, yenziwe ngendlela enqunyiwe nokuthi uMkhandlu awugudluki kuleso sabelo." )
( lwazi_0279 "Siyalubonga uxhaso lwenu ngokuthi nenze lolu suku lube yimpumelelo." )
( lwazi_0280 "Nibuyise ithemba ezimpilweni zalaba bantwana, ikakhulukazi ngalesi sikhathi sonyaka, kusho uNdlunkulu uMantfombi." )
( lwazi_0281 "Kuyaqhutshekwa nokwahlulela udaba lwesicelo, kanye nokuthatha isinqumo maqondana nesicelo sokukhosela." )
( lwazi_0282 "Siza ufunde umbuzo ngokucophelela, bese uqhwisha ibhulokwe likayebo noma cha, ekuboniseni ukuthi ufuna loko kulahlekelwa kubekelwe eceleni yini noma cha." )
( lwazi_0283 "Kungalesi sizathu esenze ukuthi uHulumeni ahlongoze izinhlaka zomthetho zokusebenzisana, ezifanele ukugqugquzela amaxhama aqinile okusebenzisana." )
( lwazi_0284 "Phakathi kwamakhosi kanye neminye imikhakha yokuphatha kaHulumeni." )
( lwazi_0285 "Lokhu kusho ukuthi umzimba wakho awube usakwazi ukuzivikela kahle ezifweni, ngendlela obuvame ukwenza ngayo ngaphambili." )
( lwazi_0286 "Umkhandlu uyinhlangano yokweluleka nokubonisana emele uMbutho wamaRizevu, ukuthi iwusize uhlale usesimeni esifanele." )
( lwazi_0287 "Uyingxenye yoMbutho wezokuVikela." )
( lwazi_0288 "Kufuneka uthintwe nganoma yimuphi uMthetho nokuphatha okuthinta uMbutho wamaRizevu." )
( lwazi_0289 "Inhloso yalolu phiko ngukugqugquzela ukwemukeleka kwemikhiqizo nemisebenzi yabezohwebo, yizakhamuzi ezibambe iqhaza emnothweni ngokwakha isithombe." )
( lwazi_0290 "Ngokuhlolisisa nokufakelela le mikhiqizo." )
( lwazi_0291 "Ngaleyo ndlela kubekeke eyabezohwebo emqondweni wezakhamuzi ezibambe iqhaza emnothweni, njengomlingani wazo emnothweni." )
( lwazi_0292 "Ubuphukuphuku obuphindiwe lobu uma ucabanga ukuthi uShaka wayesiphethe kahle kanjani." )
( lwazi_0293 "Umuntu oqhamuka endaweni yalesi sifo, ongakugomele lokho angenqatshelwa ukungena ezweni." )
( lwazi_0294 "Angagcinwa ngaphansi kokuhlolwa isikhathi, okungenani esiyizinsuku eziyisithupha ngazo ukunyakaza kwakhe kungaba nezithiyo." )
( lwazi_0295 "Ukuhlolwa akuzuthathwa njengokufihla amagama abantu." )
( lwazi_0296 "Kunjalo uma kunethuba lokuthi kuqageleke isimo somuntu sokuba negciwane lesandulela sengculazi, ngokubuya kwemiphumela." )
( lwazi_0297 "AbaseNingizimu Afrika abazeka ngokuba namakhono ayingqalizivele kanye namasu okwenza emkhakheni wemikhuba kanye nolwazi lwamasiko." )
( lwazi_0298 "Bazakumenyelwa enhlanganweni yezokusakaza yakuleli, bese banikezwa ithuba lokutshela umphakathi wonke ngalolu lwazi." )
( lwazi_0299 "Isigaba seshumi nanye sifundeka kanjena." )
( lwazi_0300 "engagunyaza inkosi, noma induna yomuntu omnyama owaziwa noma oqokwe ngaphansi kwesigatshana." )
( lwazi_0301 "Noma wesigaba sesibili, ukuba alalele futhi anqume ngecala lombango oqubuke ngenxa yomthetho wabantu abamnyama nendabuko." )
( lwazi_0302 "Owethulwe kuye ngabantu abamnyama bebodwa abakhele indawo ayilawulayo." )
( lwazi_0303 "Ngesicelo sanoma iyiphi inkosi, noma induna enikwe amandla okulawula ngaphansi kwendima." )
( lwazi_0304 "Uyogunyaza iphini laleyo nkosi, ukulalela nokunquma ngodaba lombango oqubuke ngenxa yomthetho wabantu abamnyama wendabuko." )
( lwazi_0305 "Othulwe ngaphambi kwakhe ngabantu abamnyama abakhele leyo ndawo yenkosi." )
( lwazi_0306 "INQOBO, uma iNkosi emnyama, induna noma iphini layo, bengeke banikwe amandla okunquma udaba oluthinta ukubeka eceleni, ukwehlukanisa." )
( lwazi_0307 "Noma okunye okuqondene nokwehlukanisa umshado, ngokusebenzisa lesi sigaba noma omunye umthetho." )
( lwazi_0308 "Tshela iqembu ukuthi lomsebenzi ongenhla kumele ubanike umqondo wokuthi umhlangano ubuhlelwe kahle kangakanani." )
( lwazi_0309 "Futhi manje sebezobuka ukuthi izinto kumele zenziwe kanjani, ukuze umhlangano ube nempumelelo." )
( lwazi_0310 "Ukugxamalazela ekuqhubekeni kwezinkantolo zamazwe, ukukutholela ummeli, noma ukunikeza izeluleko kwezomthetho ukukucelela ukuba ukhululwe noma ibheyili." )
( lwazi_0311 "Ukuya ezindaweni noma amajele ayingozi, ukuphenya icala ukukutholela ukuba uhlale kangcono ejele kunabanye abantu." )
( lwazi_0312 "Ngaphandle uma ngabe imithetho yomhlabuhlangene yokugcinwa kweziboshwa ingalandelwa." )
( lwazi_0313 "Asikho isidingo sokuthi baqashe laba bantu, kulaba bafundi abangasebenzi ngemuva kwezinhlaka zemifundaze." )
( lwazi_0314 "Ngokubheka nokuhlela kabusha izingqalasizinda zePosi." )
( lwazi_0315 "Ngokususa amanye amaposi, ezindaweni ezinamaposi amaningi athuthelwe ezindaweni ezingenawo amaposi ngokwanele noma aqhelelene." )
( lwazi_0316 "Lokhu kuHlanganyela Okusha kweNtuthuko yeAfrika, kuyisithembiso esenziwa ngabaholi baseAfrika, esisuselwa embonweni wabo bonke." )
( lwazi_0317 "Lokhu kufaka inkolelo egxilile yabo bonke, yokuthi banomsebenzi wokuqeda ubumpofu nokubeka amazwe abo." )
( lwazi_0318 "Lokhu kusho ngalinye noma ewonke ngokuhlanganyela, endleleni yokukhula nentuthuko nokubamba iqhaza kwezomnotho emhlabeni nasebandleni lezombusazwe." )
( lwazi_0319 "Abaxhasi abaningi esikhathini sanamuhla, bagqugquzela ukuba izinhlangano ezithile, zinabise isidleke noma imithombo yosizo." )
( lwazi_0320 "Ukuphonsa inselelo yokuqoqa imali elingana nefakwe wumxhasi." )
( lwazi_0321 "Lokhu zingakwenza ngokufuna ukwesekwa kweminye imithombo nokukhulisa umthamo woxhaso." )
( lwazi_0322 "Noma yisiphi isicelo esenziwe noma esimayelana nomuntu ocetshwa esigabeni esingaphansi, kufanele siqondiswe, sifakwe kuMgcinisihlalo weBhodi." )
( lwazi_0323 "Noma yisiphi isicelo esenziwe ngumuntu noma mayelana nomuntu ocetshwa esigabeni esingaphansi, kufanele siqondiswe kuMgcinisihlalo weBhodi." )
( lwazi_0324 "Futhi masifakwe nakumphathisikhundla owengamele iviyo umuntu othintekayo asebenza kulo." )
( lwazi_0325 "Wawuke wamfikela umcabango wokuthi uZongile amqhathe nohlanya olunguPamela." )
( lwazi_0326 "Isisebenzi kumele sithembeke kuRiphabliki, sihloniphe uMthethosisekelo, sigcine noma samukele imisebenzi esinikezwa yona imihla yonke." )
( lwazi_0327 "Wamqala ngokumjikijela ngesiqwayi esashaya ngechopho esweni lapetuka." )
( lwazi_0328 "Izimvo nemibono yomunye umuntu mayelana nesipho, indebe, umklomelo onikwe lowo muntu lapho kuvela khona izimvo, noma imibono yomunye umuntu." )
( lwazi_0329 "Igama lalowo muntu lapho livela khona, nolwazi lwakhe noluphathelene naye lowo muntu." )
( lwazi_0330 "Lapho ukudalulwa kwegama kuzoveza obala ulwazi ngomuntu osekuphele iminyaka engaphezulu kwamashumi amabili ashona." )
( lwazi_0331 "Ngenyanga edlule uNdasa, sihambe isifundazwe sonke sichazela umphakathi ukuthi zidingo zini uMnyango ozozithenga kumifelandawonye." )
( lwazi_0332 "Umphakathi wenze njani uma ubona kukhangiswe amathenda." )
( lwazi_0333 "Uma isitifiketi siphelelwa yisikhathi ngenxa yebhanoyi elitholwa nephutha elikhulu ngemuva kwengozi, siyomiswa." )
( lwazi_0334 "Noma isigameko esiphazamisa ukulungiseka koMkhiqizo okleliswe eSigabeni sokuqala, isitifiketi sokukhululwa kwendiza." )
( lwazi_0335 "Zonke izimboni zokuhluza amafutha ezimoto zaseNingizimu Afrika, sezitshale imali noma zitshala imali ukwengezelela izinto zokusebenza." )
( lwazi_0336 "Noma ubuchwepheshe obuphambili ukuze zikwazi ukukhiqiza izithako zegesi ngobuningi." )
( lwazi_0337 "Isikhungo sichitha isicelo sokufaka amathuluzi okuhweba, njengengxenye yohlu olungaphansi kwezigaba ezithile noma esigatshaneni sokuqala." )
( lwazi_0338 "Sesula ohlwini amathuluzi noma simisa ukuthengisa kwamathuluzi okuhweba emakethe yezimali." )
( lwazi_0339 "Umdayisi ozizwa ehlukumezekile, kufanele azise ngokushesha zonke ezinye izikhungo." )
( lwazi_0340 "Lapho kubhaliswe khona lama thuluzi, ngosuku lwesinqumo sokwenqaba ukwesula noma ukumiswa kwawo." )
( lwazi_0341 "Izimenenja zoKuhlolwa koMsebenzi zinomsebenzi wokuletha izinsizakalo." )
( lwazi_0342 "Ukwenza amalungiselelo, kanye nezakhiwo ezingabalulekile njengoba kuboniswa ngezansi, noma njengoba kungavunyiwe." )
( lwazi_0343 "Inkinga ebhangqwayo eyomlando kanye nokwenzekayo okuqhubekayo, kokusebenza ngolimi olulodwa." )
( lwazi_0344 "Futhi nesiko elilodwa njengokujwayelekile kunoma yisiphi isimo sezomthetho." )
( lwazi_0345 "Isithebe esethulwe ngezansi sikhombisa futhi siqhathanisa isilinganiso sezindleko zethimba lolimi, ngokuhleleka." )
( lwazi_0346 "Zithini izibongo zikaShaka?" )
( lwazi_0347 "Azive zisho yini ukuthi: uteku lwabafazi bakwaNomgabhi." )
( lwazi_0348 "Ababetekula behlezi emlovini, bethi uShaka kayikubusa kayuba nkosi." )
( lwazi_0349 "Kabanga yona-ke nje inkosi?" )
( lwazi_0350 "Kabusanga nje?" )
( lwazi_0351 "Ungaze wazikhathaza kakhulu ngabantu wena kaMaqhoboza." )
( lwazi_0352 "Noma kusemnyama kunjena nje, siyakucela ukuba uqhubeke uhole ibandla." )
( lwazi_0353 "Kuze kube yisikhathi lapho izikhulu ziyositshela ukuthi sizokwenzenjani." )
( lwazi_0354 "Yenzani pho leya ngane?" )
( lwazi_0355 "Igijimelani kangaka?" )
( lwazi_0356 "Okunye okubalulekile engifuna ukwazi wukuthi, uma umdlezane efuna ukuncelisa kufanele alubilise kuqala ubisi lwakhe." )
( lwazi_0357 "Lokhu akwenzele ukubulala amagciwane alesi sifo akulo, uyothi esuka abelupholisa elunika ingane." )
( lwazi_0358 "Sisonke sizokwakha umkhiqizo wezokuvakasha ongakwazi ukuthengiswa kwamanye amazwe ngemibukiso yamazwe ngamazwe." )
( lwazi_0359 "Igqugquzela izivakashi ukuthi zize ukuzobona ukuthi izwe lethu elihle lingabanikezani." )
( lwazi_0360 "Ukushayela emzileni wokuphuthuma ngezikhathi zasemini, kuvunyelwe izimo ezithile." )
( lwazi_0361 "Imoto elandela enye ayinalo igunya lokuphoqa imoto engaphambili ukuba ishayele emgqeni ophuzi, ukuze ikwazi ukwedlula." )
( lwazi_0362 "Imikhiqizo yokudla equkethe imithi yokuvimbela ukubola nesithako esinikeza umbala, kufanele isho igama lomuthi wokuvimbela ukubola." )
( lwazi_0363 "Noma isithako esinikeza umbala." )
( lwazi_0364 "Futhi esimweni semithi evimbela ukubola igama elisebenzayo umuthi ovimbela ukubola." )
( lwazi_0365 "Kufanele livele kanye nezinye izithako zokwengeza zokudla, zibekwe ohlwini lezithako ngegama lohlobo lwesithako." )
( lwazi_0366 "Manje tshela izingane zigxume kayishumi, bese zigxuma kahlanu ngomlenze owodwa, ziphinde zigxume kahlanu ngomunye umlenze." )
( lwazi_0367 "Uqinisile Dudu wami uma uthi ufuna ukuba ngowokuqala." )
( lwazi_0368 "Nesilungu siyasho ukuthi inyoni evuka kuqala idla icimbi elimthende." )
( lwazi_0369 "Asho maqede amoyizele yedwa uMveli ngoba isenzo somkakhe sokunakekela impilo yakhe sasimhlaba umxhwele." )
( lwazi_0370 "Hayi ke bengithi ngifuna yena umtshele ukuthi ipasi lakhe ngilitholile emotweni." )
( lwazi_0371 "Uma isikhulu esiphethe sandisa umholo wesikhundla njengoba kumiselwe esiqondisweni esithile." )
( lwazi_0372 "Kwakunele kufike ukuhlwa azivalele ekameleni lakhe ngenxa yokucasulwa yimikhuba eyayenziwa kuleli flethi." )
( lwazi_0373 "Uma imvume ingakakhishwa, buza uhulumeni ezwe umbono wakho, ngezinkomba nemithelela okumele ibhekisiswe." )
( lwazi_0374 "Lokhu kungenhloso yokuqikelela ukuthi intuthuko iyochuma ihlale isikhathi eside?" )
( lwazi_0375 "Bamxilongile abahlengi kanye nomntwana wakhe, base benquma ukuthi balethwe lapha bazobonelwa eduzane odokotela." )
( lwazi_0376 "Amanye amazwe anezinhlelo ezithile zokwethula uxhaso lwemishini ethile emabhizinisini." )
( lwazi_0377 "Ethula nosizo lwezimali oluqondene namakhono okuthenga." )
( lwazi_0378 "Umshini olindelwe mayelana nokugcina ibanga lokuphakama nohlelo, nokuthi lufakiwe futhi lusebenza ngendlela eqondile uhlelo lokuqwashisa." )
( lwazi_0379 "Kanjalo awukho umgomo noma izihibe zokunqanda umsebenzi." )
( lwazi_0380 "Inhlangano yezilimi isebenza njengengxenye kaHulumeni yongoti bezilimi, ngokuhumusha imibhalo ebhalwe ngolunye ulimi olwamukelekile." )
( lwazi_0381 "Iyihumushela kwezinye izilimi ezamukelekile ngokomthetho." )
( lwazi_0382 "Ekwenzeni uhlelo lwakho lonyaka, ungabhekelela lokhu okulandelayo." )
( lwazi_0383 "Izinsuku lapho umasipala ezobe ebambe ngazo izingxoxo zokubonisana ongathanda ukubamba iqhaza kuzo." )
( lwazi_0384 "Njengohlelo lokuthuthukisa okuhlanganisayo, kanye nokuhanjiswa kwezimali, izindaba  zomphakathi ezisemqoka." )
( lwazi_0385 "Yini okungenziwa yikomiti lewadi ukusiza?" )
( lwazi_0386 "Kumele ukwenze nini lokhu?" )
( lwazi_0387 "Iphoyisa kumele limazise futhi limchazele wonke la malungelo lowo muntu oboshwayo." )
( lwazi_0388 "Malenze nesiqinisekiso sokuthi uyawaqondisisa ngokwesigaba samashumi amathathu nanhlanu soMthethosisekelo." )
( lwazi_0389 "Lapho kungunobhala womholi wendabuko noma omunye umholi womphakathi ogunyazwe umholi wendabuko, kuyadingeka ukuthi kube nencwadi yokuncoma ebhalwe ngumholi wendabuko, ukuthi iphelezele isicelo." )
( lwazi_0390 "Umuntu ocelayo, kufanele asho ukuthi, ufuna ikhophi yerekhodi yini, noma ufuna ukuza azolibheka ehhovisi lesikhungo somphakathi." )
( lwazi_0391 "Geza izandla zakho emanzini abilayo noma elashiwe, emva kokusebenzisa indlu yangasese nangaphambi kokuthinta ukudla." )
( lwazi_0392 "Ungqongqoshe engaqokela ukusebenza kwalo Mthetho, noma izigaba ezithile zawo kuyo yonke iNingizimu Afrika." )
( lwazi_0393 "Noma ezindaweni ezithile kuphela, ukuba ziqondane nomuntu othile." )
( lwazi_0394 "Lowo muntu abe onogqozi noma onolwazi oluthile ngenyama noma ngokuphepha kwaleyo nyama." )
( lwazi_0395 "USenzo uvela esigcawini sokuqala nje enkundleni yokuqala abonakale ethanda uNozi futhi efuna ukushada naye." )
( lwazi_0396 "Ngokucacile, inkosikazi eshade ngosiko lwasentshona nezingane zilahlekelwa yisikhundla esingcono." )
( lwazi_0397 "Zakleliswa ngokulinganayo nonkosikazi nezingane ezilahlwe ngenxa yomshado  wesintu." )
( lwazi_0398 "Cha nembala igane esokeni mfo kaLabase, nami nakanjani ngizokuvakashela kule mpelasonto ngizobona lophuma langa sikothe wentombi." )
( lwazi_0399 "Khuluma nomuntu osendaweni eyodwa naye, kube khona inani elingangamagxathu ezinyawo ezintathu, noma ezinhlanu uma ukhuluma." )
( lwazi_0400 "Hlamba izandla ngemuva kokuqala ukulungisela ukupheka ukudla." )
( lwazi_0401 "Nangaphambi kokuphazamiseka, okungaba ukushintsha noma ukuhlamba ingane, ukusebenzisa ithoyilethi." )
( lwazi_0402 "Bheka ngoba baze balikhipha ngesihloko elithi le ndawo bazoyithatha noma kanjani." )
( lwazi_0403 "Gcizelela futhi ukuthi abantu bangesabi ukubuza imibuzo." )
( lwazi_0404 "Inani eliphelele lentela kunyaka ogcwele, ususe intela ekhokhelwa abasebenzi ekhokhelwe unyaka ogcwele." )
( lwazi_0405 "Ususe umkhawulo ovunyelwe wezimali zentela yangaphandle yonyaka ogcwele, kususwe inani elikhokhiwe lesikhathi sokuqala sonyaka." )
( lwazi_0406 "Qinisekisa ukuthi unegunya lokwenza lokhu, bese ubhala isikhundla sakho ngaphakathi enhlanganweni." )
( lwazi_0407 "UShaka usebenzisa umkhonto ophonswayo njengesikhali sokugwaza eduze kwesitha, kunokuba ame kude naso." )
( lwazi_0408 "UNgqongqoshe kanye nomphathi-hhovisi wakwahulumeni ogunyaziwe nguNgqongqoshe." )
( lwazi_0409 "Uma ethola isicelo esibhalwe phansi somuntu ogunyaziwe ngaphansi kwesigatshana sesine, angawaqeda amandla alowo muntu okushadisa ngokubhala phansi." )
( lwazi_0410 "Makube maqondana nokuthi ahlanganise ubudlelwano bezakhamuzi ngaphansi kwalesi  Sahluko." )
( lwazi_0411 "Phela uma ngizwa iphunga lenyama ngikhumbula leziya zinsuku uMaZondi asasebenza lapha." )
( lwazi_0412 "Uzokwazi ukuhlela kangcono." )
( lwazi_0413 "Ubambe iqhaza ngokuyimpumelelo ezingxoxweni eziphathelene nenqubomgomo yomkhandlu, kanye nezinhlelo noma imisebenzi." )
( lwazi_0414 "Uzoba wazi kabanzi ngomphakathi wakho ukwedlula wonke umuntu." )
( lwazi_0415 "Selokhu uqalile lo nyaka isonto liphuma ligamenxe ihora lesibili, kuya ehoreni lesithathu." )
( lwazi_0416 "Gcwalisa ifomu lokufaka isicelo ehhovisi labaphethe izimoto ezihamba emgwaqweni eliseduze nawe." )
( lwazi_0417 "Yayixoxwa ngubani pho ngoba wayehamba eyihlobisa ngamahlaya bafe yinsini." )
( lwazi_0418 "Khumbuza iqembu ukuthi isijobelelo isithupha singabanika ulwazi olufingqiwe ngokhetho nezinqubo zokuvota." )
( lwazi_0419 "UPhumla wathi engena nje wayetshela umngani wakhe ukuthi kunendaba emnandi azomxoxela yona." )
( lwazi_0420 "Waklewula umkakhe ebona ingane yabantu indiza emoyeni ibuya ithanqazeka phansi etiyeleni." )
( lwazi_0421 "Phuza uhlobo olulodwa lotshwala ngesikhathi, ungaphuzi bese ushayela noma uhambe egwaqweni." )
( lwazi_0422 "Kwathi lapho umama eqhaqha isipho engasiphiwa kubaba wakho, bajabula bonke endlini." )
( lwazi_0423 "Ungabachaza kanjani abantu beqembu ogxile kulo ngokwalo mklamo." )
( lwazi_0424 "Wayeseyophuma ngesango uZongile ngesikhathi uMaqhinga egijima enzansi kwesibaya emjaha." )
( lwazi_0425 "Sizolokhu sibheka amanye amathuba esingaxhasa ngawo imifelandawonye." )
( lwazi_0426 "Manje xoxani ngokuthi bekunjani ngesikhathi abantwana bedonsa umoya ungena emaphashini abo." )
( lwazi_0427 "Labo abafaka izicelo komele bazazise ukuthi bahlobene kanjani kweminye imikhakha." )
( lwazi_0428 "Isikhalo noma impikiswano ingaxazululwa ngendlela efanele uma amaqembu omabili avuma ukuxoxisana." )
( lwazi_0429 "Umuntu noma umkhwenyana noma umkakhe obhala incwadi yefa noma ingxenye yayo ebhalela uMabiwefa." )
( lwazi_0430 "Uma kuyisidlo nje kufanele ikhadi libe nesikhathi okuyodliwa ngaso nokuthi umcimbi uyophela nini." )
( lwazi_0431 "Ngangilokhu ngibabona bengena bededelana emgqeni wokukhipha nokufaka imali." )
( lwazi_0432 "Ngesikhathi senza uphenyo sathola ukuthi umyeni wakhe kade entshontsha amaphilisi akhe." )
( lwazi_0433 "Ungihlabe umxhwele lo mcabango wenu, wokuqoqela abantu abadala imali." )
( lwazi_0434 "Bangaqala ukuphuza utshwala basebenzise nezidakamizwa ukuzama ukuqhelisa ingcindezi." )
( lwazi_0435 "Indaba enje ingaveza ukujula komqondo wombhali futhi abaningi bayithatha njengeqiniso lempela." )
( lwazi_0436 "Ukusho kwakho isimo odinga ngaso irekhodi sihambisana ke nesimo elitholakala ngaso irekhodi." )
( lwazi_0437 "Uma ungumzali uyadinga ukuthi uxoxe nezingane zakho ngobubi botshwala nemiphumela yabo." )
( lwazi_0438 "Ubabomncane naye wayeyizonde kabi imidlalo yemali efana nawo amahhashi lana." )
( lwazi_0439 "Uyabahlinzeka nje abashayeli bakho ngamagilavu enjoloba ukuze bawagqoke lapho besiza olimele na?" )
( lwazi_0440 "Thenga imifino nezithelo okugcinwe emthunzini ngoba ilanga liqeda umsoco omningi obalulekile." )
( lwazi_0441 "Linda okungenani izinsuku eziyishumi ukuthi ihhovisi legatsha lendawo libhekane nesicelo sakho." )
( lwazi_0442 "Kunemihlomulo eminingi ngokwethula izifundo lapho kusetshenziswa uhlelo lwe-inthanethi." )
( lwazi_0443 "Zagonana izintokazi kuyilokhu zagcinana mzukwane zithweswa iziqu ehholo laseBhekuzulu." )
( lwazi_0444 "Amagama amasha kudingeka ukuba ade esetshenziswa ephindelela aze agxile emiqondweni yabafundi." )
( lwazi_0445 "Leso sicelo siyokwenziwa emkhandlwini kuleyo ndawo lapho kuqhutshwa khona isenzo esisohlwini." )
( lwazi_0446 "Habe, ngithini nje ngempela." )
( lwazi_0447 "Sizoyaphi?" )
( lwazi_0448 "Ingani nogogo ozala umama akasekho nje!" )
( lwazi_0449 "Umgcinisihlalo walayela ukuthi ummangalelwa ahlale phansi wase ecela ukuthi ummangali asukume." )
( lwazi_0450 "Dwebela lona wesifazane isithombe sokudla okunempilo okungamsiza ekutheni anciphe  emzimbeni." )
( lwazi_0451 "Baqhubeka njalo bazixoxela bobabili beluka iqhinga abafanele balenze ukulwa nalesi sifo." )
( lwazi_0452 "Layibuka iphoyisa lansondo qede layidlulisela kuzakwabo omi emva kwekhamera." )
( lwazi_0453 "Wasidumela uThula wasixhuma emlonyeni waphuza ebheke phezulu." )
( lwazi_0454 "UNyoka useyangixosha manje." )

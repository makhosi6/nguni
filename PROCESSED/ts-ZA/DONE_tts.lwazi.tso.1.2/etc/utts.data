(data_281 "Vutomi bya ku tirhisa vuxaka bya karhata." )
(data_282 "Rirhandzu ri hundzuka risimu ra chela." )
(data_283 "Kambe n'wini u swi endle hi vutivi." )
(data_284 "Sweswi ndzi hefemulaka ndzi siya miehleketo endzhaku." )
(data_285 "Xana yena u baleka kwihi?" )
(data_286 "Loko timbyana ti vukula vutomi byi sungula ku nyenyetsa." )
(data_287 "Munhu u tshama a ri munhu." )
(data_288 "Thyaka hi rona ri susiwaka emirini." )
(data_289 "Hi masiku timbilu tinyingi ti le ndzeni ka makwanga." )
(data_290 "Kasi makasana a hi tata wa wena?" )
(data_291 "Swona Yingwani malume wa wena a nga kona ke?" )
(data_292 "Tikhorwise hi leswi u nyikiwa swona." )
